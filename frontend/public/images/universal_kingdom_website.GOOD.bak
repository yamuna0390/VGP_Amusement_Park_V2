      <div class="map-panel">
        <div class="section-head" style="margin-bottom:16px"><div class="scroll-banner"><span class="kicker">Find your way around</span><h2>Park Map</h2></div></div>
        <img src="assets/img_57957d8c2b63.jpg" loading="lazy" decoding="async" alt="VGP Universal Kingdom park map with all 79 attractions">
      </div>
    </div>
  </section>
</div>

<!-- ================= BOOK NOW ================= -->
<div class="page" id="page-book">
  <section>
    <div class="wrap">
      <div class="section-head"><div class="scroll-banner sb-scroll"><span class="kicker">Your day, planned</span><h2>Book Now</h2></div></div>
      <div class="steps">
        <div class="step now" id="st1" onclick="bookStep(1)"><span class="num">1</span> Date &amp; Offers</div>
        <div class="step" id="st2" onclick="gotoStep(2)"><span class="num">2</span> Tickets</div>
        <div class="step" id="st3" onclick="gotoStep(3)"><span class="num">3</span> Food</div>
        <div class="step" id="st4" onclick="gotoStep(4)"><span class="num">4</span> Checkout</div>
      </div>

      <!-- Step 1: offers left, date right -->
      <div id="bstep1">
        <div class="book-grid">
          <div class="book-offers">
            <div class="offers-head">
              <h3 class="plan-title">🎁 Pick an offer <span class="opt">(optional)</span></h3>
              <p class="offers-sub" id="offer-hint">Tap an offer to see its valid dates</p>
            </div>
            <div id="plan-offers" class="offers-strip"></div>
          </div>
          <div class="panel book-date">
            <h3>📅 Choose your visit date</h3>
            <p style="font-weight:700;color:var(--green-deep);margin-bottom:10px">7 hours of non-stop thrills — open all 365 days, 24×7!</p>
            <div class="cal" id="cal"></div>
            <div class="nav-btns"><span></span><button class="btn-next" onclick="proceedDate()">Proceed to Tickets ➜</button></div>
          </div>
        </div>
      </div>

      <!-- Step 2: tickets (real prices from vgpuniversalkingdom.in) -->
      <div class="panel" id="bstep2" style="display:none">
        <h3>🎟️ Select your Fun Passes</h3>
        <p class="tax-note">All prices shown are <b>before tax</b>. GST is added at checkout — <b>18%</b> on theme-park tickets and <b>5%</b> on food.</p>
        <div id="ll-hint" class="ll-hint" style="display:none"></div>
        <div class="qty-row" onclick="ticketPopup('Adult')"><div class="info"><b>Adult Fun Pass</b><span>Theme Park & Beach Access · <s>₹975.00</s> <b class="sale">₹828.75</b></span></div><div class="qty" onclick="event.stopPropagation()"><button onclick="chg('adult',-1)">−</button><b id="q-adult">1</b><button onclick="chg('adult',1)">+</button></div></div>
        <div class="qty-row" onclick="ticketPopup('Child')"><div class="info"><b>Child Fun Pass</b><span>90–130 cm · Theme Park & Beach · <s>₹763.00</s> <b class="sale">₹648.55</b></span></div><div class="qty" onclick="event.stopPropagation()"><button onclick="chg('child',-1)">−</button><b id="q-child">0</b><button onclick="chg('child',1)">+</button></div></div>
        <div class="qty-row" onclick="ticketPopup('Senior')"><div class="info"><b>Senior Citizen Fun Pass</b><span>Age 60+ with valid ID · <s>₹763.00</s> <b class="sale">₹648.55</b></span></div><div class="qty" onclick="event.stopPropagation()"><button onclick="chg('senior',-1)">−</button><b id="q-senior">0</b><button onclick="chg('senior',1)">+</button></div></div>
        <div class="qty-row" onclick="ticketPopup('Student')"><div class="info"><b>College Student ID Fun Pass</b><span>Valid ONLY with college ID card display · ₹780.00</span></div><div class="qty" onclick="event.stopPropagation()"><button onclick="chg('student',-1)">−</button><b id="q-student">0</b><button onclick="chg('student',1)">+</button></div></div>
        <div class="qty-row" onclick="ticketPopup('Double')"><div class="info"><b>Double Fun Pass — Adult</b><span>Universal Kingdom + Marine Kingdom · <s>₹1,715.00</s> <b class="sale">₹1,313.00</b></span></div><div class="qty" onclick="event.stopPropagation()"><button onclick="chg('dfpa',-1)">−</button><b id="q-dfpa">0</b><button onclick="chg('dfpa',1)">+</button></div></div>
        <div class="qty-row" onclick="ticketPopup('Double')"><div class="info"><b>Double Fun Pass — Child</b><span>Universal Kingdom + Marine Kingdom · <s>₹1,403.00</s> <b class="sale">₹1,128.00</b></span></div><div class="qty" onclick="event.stopPropagation()"><button onclick="chg('dfpc',-1)">−</button><b id="q-dfpc">0</b><button onclick="chg('dfpc',1)">+</button></div></div>
        <div class="live-total"></div>
        <div class="nav-btns"><button class="btn-back" onclick="bookStep(1)">⬅ Back</button><button class="btn-next" onclick="bookStep(3)">Next: Food ➜</button></div>
      </div>

      <!-- Step 3: add-on food -->
      <div class="panel" id="bstep3" style="display:none">
        <h3>🍽️ Add Meals &amp; Combos <span class="mini">(optional)</span></h3>
        <p class="tax-note">Pre-book meals from Kutti Raja's Royal Kitchen — served hot, skip the queue. Outside food is not allowed inside the park.</p>
        <div class="meal-grid">
          <div class="meal-card"><div class="meal-emoji bg-green">🥗</div><span class="veg-dot">● Veg</span><h4>Veg Meal</h4><p>South-Indian thali — rice, curries, poriyal &amp; sweet.</p><div class="meal-foot"><b>₹250</b><div class="qty"><button onclick="chg('veg',-1)">−</button><b id="q-veg">0</b><button onclick="chg('veg',1)">+</button></div></div></div>
          <div class="meal-card"><div class="meal-emoji bg-red">🍗</div><span class="nonveg-dot">● Non-veg</span><h4>Non-veg Meal</h4><p>Chicken curry, flavoured rice &amp; dessert.</p><div class="meal-foot"><b>₹300</b><div class="qty"><button onclick="chg('nonveg',-1)">−</button><b id="q-nonveg">0</b><button onclick="chg('nonveg',1)">+</button></div></div></div>
          <div class="meal-card"><div class="meal-emoji bg-blue">🧒</div><h4>Kids Happy Meal</h4><p>Mini meal + a treat &amp; a little surprise.</p><div class="meal-foot"><b>₹199</b><div class="qty"><button onclick="chg('kids',-1)">−</button><b id="q-kids">0</b><button onclick="chg('kids',1)">+</button></div></div></div>
          <div class="meal-card"><div class="meal-emoji bg-purple">🍿</div><h4>Snack &amp; Beverage Pack</h4><p>Popcorn/fries + a chilled drink.</p><div class="meal-foot"><b>₹149</b><div class="qty"><button onclick="chg('snacks',-1)">−</button><b id="q-snacks">0</b><button onclick="chg('snacks',1)">+</button></div></div></div>
        </div>
        <div class="live-total"></div>
        <div class="nav-btns"><button class="btn-back" onclick="bookStep(2)">⬅ Back</button><button class="btn-next" onclick="bookStep(4)">Next: Checkout ➜</button></div>
      </div>

      <!-- Step 4: checkout -->
      <div class="panel" id="bstep4" style="display:none">
        <h3>🧾 Checkout</h3>
        <div id="coupon-zone"></div>
        <div class="applied-offer" id="applied-offer"></div>
        <div class="two-col">
          <div class="field"><label for="c-name">Name</label><input id="c-name" autocomplete="name" placeholder="Your full name"></div>
          <div class="field"><label for="c-email">Email</label><input id="c-email" type="email" autocomplete="email" placeholder="you@example.com"></div>
          <div class="field"><label for="c-phone">Contact</label><input id="c-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+91 98xxxxxxxx"></div>
          <div class="field"><label for="c-date">Visit Date</label><input id="c-date" disabled></div>
        </div>
        <div class="summary" id="summary"></div>
        <p style="font-size:.8rem;font-weight:700;color:var(--green-deep);margin-top:10px">T&C: No cancellation/postponement after booking · Entry free for children below 90 cm · Senior citizens 60+ and students must carry valid ID.</p>
        <label class="media-consent"><input type="checkbox" id="media-consent"> <span>I have read and agree to the VGP Universal Kingdom <a onclick="showTerms(event)">Terms &amp; Conditions</a>, Privacy Policy, and cancellation &amp; refund policy. I understand that approved refunds may take 15 to 30 days to reflect in the original payment method.</span></label>
        <div class="nav-btns"><button class="btn-back" onclick="bookStep(3)">⬅ Back</button><button class="btn-next" onclick="pay()">Pay & Get Tickets 🎟️</button></div>
      </div>
    </div>
  </section>
</div>

<!-- ================= TOUR OPERATOR REGISTRATION ================= -->
<div class="page" id="page-optreg">
  <section><div class="wrap" style="max-width:840px">
    <div class="section-head"><div class="scroll-banner sb-ribbon"><span class="kicker">Partner with the Kingdom</span><h2>Tour Operator Registration</h2></div></div>
    <div id="optreg-msg"></div>
    <div id="optreg-form">
      <div class="reg-steps">
        <div class="reg-step now" id="rst1"><span class="ri">👤</span> Personal Details</div>
        <div class="reg-step" id="rst2"><span class="ri">🏢</span> Agency Details</div>
        <div class="reg-step" id="rst3"><span class="ri">🏦</span> Bank Details</div>
      </div>

      <div class="panel reg-panel" id="rstep1">
        <h3>Enter your details</h3>
        <div class="two-col">
          <div class="field"><label for="o-name">Full Name</label><input id="o-name" autocomplete="name" placeholder="Your full name"></div>
          <div class="field"><label for="o-email">Email</label><input id="o-email" type="email" autocomplete="email" placeholder="you@example.com"></div>
          <div class="field"><label for="o-mobile">Mobile Number</label><input id="o-mobile" type="tel" inputmode="tel" placeholder="+91 98xxxxxxxx"></div>
          <div class="field"><label for="o-desig">Designation</label><input id="o-desig" placeholder="e.g. Owner / Manager"></div>
          <div class="field"><label for="o-pass">Password</label><input id="o-pass" type="password" placeholder="Min 6 characters"></div>
          <div class="field"><label for="o-pass2">Confirm Password</label><input id="o-pass2" type="password" placeholder="Re-enter password"></div>
        </div>
        <div class="nav-btns"><span></span><button class="btn-next" onclick="optStep(2)">Next ➜</button></div>
      </div>

      <div class="panel reg-panel" id="rstep2" style="display:none">
        <h3>Agency Details</h3>
        <div class="field"><label for="a-logo">Upload Company Logo</label><input id="a-logo" type="file" accept="image/*"></div>
        <div class="field"><label for="a-name">Agency Name</label><input id="a-name" placeholder="Agency name"></div>
        <div class="field"><label for="a-addr">Company Address / Location</label><textarea id="a-addr" rows="3" placeholder="Full address"></textarea></div>
        <div class="two-col">
          <div class="field"><label for="a-pin">PinCode</label><input id="a-pin" inputmode="numeric" placeholder="Postal code"></div>
          <div class="field"><label for="a-state">State</label><select id="a-state"><option value="">Select value</option><option>Andhra Pradesh</option><option>Assam</option><option>Bihar</option><option>Chhattisgarh</option><option>Delhi</option><option>Goa</option><option>Gujarat</option><option>Haryana</option><option>Himachal Pradesh</option><option>Jharkhand</option><option>Karnataka</option><option>Kerala</option><option>Madhya Pradesh</option><option>Maharashtra</option><option>Odisha</option><option>Punjab</option><option>Rajasthan</option><option>Tamil Nadu</option><option>Telangana</option><option>Uttar Pradesh</option><option>Uttarakhand</option><option>West Bengal</option></select></div>
          <div class="field"><label for="a-district">District</label><input id="a-district" placeholder="District"></div>
          <div class="field"><label for="a-city">City</label><input id="a-city" placeholder="City"></div>
          <div class="field"><label for="a-pan">PAN Number</label><input id="a-pan" placeholder="PAN Number"></div>
          <div class="field"><label for="a-gst">GST Number</label><input id="a-gst" placeholder="GST Number"></div>
        </div>
        <div class="field"><label for="a-pancopy">Upload PAN Card Copy</label><input id="a-pancopy" type="file" accept="image/*,.pdf"></div>
        <div class="two-col">
          <div class="field"><label for="a-idtype">ID Type</label><select id="a-idtype"><option value="">Select ID Type</option><option>Aadhaar</option><option>Passport</option><option>Driving Licence</option><option>Voter ID</option></select></div>
          <div class="field"><label for="a-idproof">Upload ID Proof</label><input id="a-idproof" type="file" accept="image/*,.pdf"></div>
        </div>
        <div class="nav-btns"><button class="btn-back" onclick="optStep(1)">⬅ Previous</button><button class="btn-next" onclick="optStep(3)">Next ➜</button></div>
      </div>

      <div class="panel reg-panel" id="rstep3" style="display:none">
        <h3>Enter bank details</h3>
        <div class="two-col">
          <div class="field"><label for="b-bank">Bank</label><input id="b-bank" placeholder="Bank name"></div>
          <div class="field"><label for="b-acc">Account Number</label><input id="b-acc" inputmode="numeric" placeholder="Account number"></div>
          <div class="field"><label for="b-benef">Beneficiary Name</label><input id="b-benef" placeholder="Beneficiary name"></div>
          <div class="field"><label for="b-ifsc">IFSC Code</label><input id="b-ifsc" placeholder="IFSC code"></div>
        </div>
        <div class="field"><label for="b-cheque">Upload Cancelled Cheque</label><input id="b-cheque" type="file" accept="image/jpeg,image/png,image/jpg"></div>
        <label class="cz-check"><input type="checkbox" id="b-agree"> I agree to the <a class="reg-back">privacy policy</a> &amp; <a class="reg-back">terms</a></label>
        <div class="nav-btns"><button class="btn-back" onclick="optStep(2)">⬅ Previous</button><button class="btn-next cta-green" onclick="optSubmit()">Submit</button></div>
      </div>
    </div>
    <p style="text-align:center;margin-top:18px"><a class="reg-back" onclick="closeModal('login-modal');openLogin('operator')">‹ Back to login</a></p>
  </div></section>
</div>

<!-- ================= TOUR OPERATOR PORTAL ================= -->
<div class="page" id="page-optportal">
  <div class="op-top">
    <div class="op-brand"><span class="op-logo">VGP</span><b>Tour Operator Partner Portal</b></div>
    <div class="op-topr"><span class="op-agency" id="op-agency">Agency</span><button class="op-icon" title="Notifications" onclick="toast('🔔 3 new notifications')">🔔</button><button class="op-logout" onclick="opLogout()">Logout</button></div>
  </div>
  <div class="op-shell">
    <aside class="op-nav" id="op-nav"></aside>
    <main class="op-main" id="op-main"></main>
  </div>
</div>

