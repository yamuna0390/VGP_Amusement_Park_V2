    <div class="section-head"><div class="scroll-banner"><span class="kicker">Wake up beside the waves</span><h2>Stay — Room Bookings</h2></div></div>
    <div class="grid g3">
      <div class="card"><div class="card-media bg-blue">🌅</div><div class="card-body"><span class="tag">Sea View</span><h3>Beach Cottages</h3><p>₹4,500/night · Steps from the private beach.</p><button class="apply pill" style="margin-top:10px" onclick="toast('🛏️ Cottage enquiry sent!')">Check Dates</button></div></div>
      <div class="card"><div class="card-media bg-green">🏠</div><div class="card-body"><span class="tag">Family</span><h3>Family Suites</h3><p>₹3,200/night · Sleeps 4, park-view balcony.</p><button class="apply pill" style="margin-top:10px" onclick="toast('🛏️ Suite enquiry sent!')">Check Dates</button></div></div>
      <div class="card"><div class="card-media bg-purple">🛌</div><div class="card-body"><span class="tag">Budget</span><h3>Standard Rooms</h3><p>₹2,000/night · Comfortable AC rooms for groups.</p><button class="apply pill" style="margin-top:10px" onclick="toast('🛏️ Room enquiry sent!')">Check Dates</button></div></div>
    </div>
  </div></section>
</div>

