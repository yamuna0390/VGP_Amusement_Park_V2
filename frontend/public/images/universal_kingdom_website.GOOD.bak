 {id:"birthday",code:"BIRTHDAYBOGO",name:"Birthday Buddy Treat",badge:"Birthday month",bg:"bg-red",kind:"bogo-samecat",cats:["adult","child","senior","student"],minQty:2,weekdays:null,visitStart:"2026-07-01",visitEnd:"2026-12-31",bookEnd:"2026-12-31",online:false,needsId:true,needsDob:true,active:true,priority:4,desc:"Buy 1 ticket and get 1 free (same category) during the birthday person's birth month. Valid DOB proof required at entry.",dateLabel:"During the birthday person's birth month"},
 {id:"midweek",code:"ADITHALUBADI",name:"Adi Thalubadi",badge:"Tue & Wed · Jul 21–Aug 12",bg:"bg-blue",kind:"b2g1-samecat",cats:["adult","child","senior","student"],minQty:3,weekdays:[2,3],visitStart:"2026-07-21",visitEnd:"2026-08-12",bookEnd:"2026-08-12",online:false,needsId:false,needsDob:false,active:true,priority:7,desc:"Buy 2 tickets and get 1 FREE (all three same category) on Tuesdays & Wednesdays, 21 July – 12 August 2026.",dateLabel:"Tuesdays & Wednesdays · 21 Jul – 12 Aug 2026"},
 {id:"friendship",code:"FRIENDTRIO",name:"Friendship Trio Fun Pass",badge:"2 Aug only",bg:"bg-yellow",kind:"b2g1-samecat",cats:["adult","child","senior","student"],minQty:3,weekdays:null,visitStart:"2026-08-02",visitEnd:"2026-08-02",bookEnd:"2026-08-02",online:false,needsId:false,needsDob:false,active:true,priority:6,desc:"Two besties book, the third goes FREE! Buy 2 get 1 free (all three same category), visit on 2 August 2026.",dateLabel:"Visit on 2 August 2026"},
 {id:"double",code:"DOUBLEFUN",name:"Double Fun Pass",badge:"2-day pass",bg:"bg-purple",kind:"info-double",cats:["dfpa","dfpc"],minQty:1,weekdays:null,visitStart:"2026-07-01",visitEnd:"2026-12-31",bookEnd:"2026-12-31",online:false,needsId:false,needsDob:false,active:true,priority:2,desc:"Two days, double the adventures, one special price. Adult ₹1,313 (save ₹402) · Child ₹1,128 (save ₹275).",dateLabel:"Any day · two-day validity"}
];
function loadOffers(){var base=OFFER_DEFAULTS.map(function(o){return Object.assign({},o);});try{var ov=JSON.parse(localStorage.getItem('ukdOffers')||'null');if(ov){base.forEach(function(o){if(ov[o.id])Object.assign(o,ov[o.id]);});}}catch(_){}return base;}
function saveOffers(map){try{localStorage.setItem('ukdOffers',JSON.stringify(map));}catch(_){}offers=loadOffers();}
let offers=loadOffers();
function dowOf(d){return new Date(d+'T12:00:00').getDay();}
function addDay(d,n){var t=new Date(d+'T12:00:00');t.setDate(t.getDate()+n);return t.toISOString().slice(0,10);}
function offStatus(o,today){if(!o.active||!o.visitStart||!o.visitEnd)return 'inactive';if(today>o.visitEnd||today>o.bookEnd)return 'expired';if(today<o.visitStart)return 'upcoming';return 'active';}
function firstEligibleVisit(o,fromISO){var t=todayISO();var start=(o.visitStart>fromISO?o.visitStart:fromISO);var d=(start>t?start:addDay(t,1));for(var i=0;i<400;i++){if(d>o.visitEnd||d>o.bookEnd)return null;if(d>t&&(!o.weekdays||o.weekdays.indexOf(dowOf(d))>=0))return d;d=addDay(d,1);}return null;}
function dateEligible(o,date){var t=todayISO();if(!date||date<=t)return false;var st=offStatus(o,t);if(st==='inactive'||st==='expired')return false;if(date<o.visitStart||date>o.visitEnd)return false;if(t>o.bookEnd)return false;if(o.weekdays&&o.weekdays.indexOf(dowOf(date))<0)return false;return true;}
function dateOk(id,date){var o=offers.find(function(x){return x.id===id;});return o?dateEligible(o,date):false;}
function priceTag(o){switch(o.kind){case 'online15':return '15% OFF';case 'pct-cat':return o.pct+'% OFF';case 'flat-adult':return '₹'+o.flat+'+tax';case 'kids':return 'KIDS FREE';case 'bogo-samecat':return 'BUY 1 GET 1';case 'b2g1-samecat':return 'BUY 2 GET 1';case 'info-double':return '2-DAY';default:return '';}}
function bogoSameCat(cats){var amt=0,free=0;cats.forEach(function(k){var n=qty[k]||0;var f=Math.floor(n/2);free+=f;amt+=f*prices[k];});return {amt:amt,free:free};}
var bdayDob='',bdayName='',bdayCompanion='',bdayOk=false;
function birthdayFree(){var cats=['adult','child','senior','student'],best=0;cats.forEach(function(k){if((qty[k]||0)>=2&&prices[k]>best)best=prices[k];});return best;}
function bdaySet(){bdayDob=(document.getElementById('bd-dob')||{}).value||'';bdayName=(document.getElementById('bd-name')||{}).value||'';bdayCompanion=(document.getElementById('bd-companion')||{}).value||'';bdayOk=!!(document.getElementById('bd-ok')||{}).checked;renderCheckout();}
function b2g1SameCat(cats){var amt=0,free=0;cats.forEach(function(k){var n=qty[k]||0;var f=Math.floor(n/3);free+=f;amt+=f*prices[k];});return {amt:amt,free:free};}
function reasonUnavailable(o){var t=todayISO();if(offStatus(o,t)==='expired')return '⏳ This offer has expired.';if(offStatus(o,t)==='inactive')return '⚠️ This offer is not currently active.';if(!selDate)return '📅 '+o.dateLabel+'.';if(selDate<=t)return '⚠️ Offers close at 12 AM — pick a future visit date.';var nx=firstEligibleVisit(o,selDate);return '⚠️ '+o.name+' is not valid for '+selDate+'.'+(nx?(' Next eligible date: '+nx+'.'):' No eligible date available — continue at the regular ticket price.');}
function littleLegends(){var A=qty.adult||0,C=qty.child||0;var free=Math.min(C,A*2);var qualAdults=Math.ceil(free/2);var extra=C-free;var surcharge=qualAdults*((mrp.adult||prices.adult)-prices.adult);var saving=free*prices.child-surcharge;return {A:A,C:C,free:free,qualAdults:qualAdults,extra:extra,surcharge:surcharge,saving:saving};}
function evalOffer(o){if(!dateEligible(o,selDate))return {amt:0,ok:false,note:reasonUnavailable(o)};switch(o.kind){
 case 'online15':{if(!qty.adult&&!qty.child&&!qty.senior)return {amt:0,ok:false,note:'ℹ️ Applies to Adult, Child & Senior Fun Passes.'};return {amt:0,ok:true,note:'✅ 15% online discount already included in the shown prices.'};}
 case 'pct-cat':{var c=o.cats[0];var n=qty[c]||0;if(n<1)return {amt:0,ok:false,note:'ℹ️ Add a '+labels[c]+' to use this offer.'};return {amt:o.pct/100*n*prices[c],ok:true,note:'🪩 '+o.pct+'% off '+labels[c]+' — carry valid ID at entry.'};}
 case 'flat-adult':{if(!qty.adult)return {amt:0,ok:false,note:'ℹ️ Add an Adult Fun Pass for the ₹'+o.flat+' special.'};return {amt:qty.adult*Math.max(0,prices.adult-o.flat),ok:true,note:'🇮🇳 Adult Fun Pass at ₹'+o.flat+' (before tax) each.'};}
 case 'kids':{if(!qty.adult)return {amt:0,ok:false,note:'ℹ️ Add at least 1 Adult Fun Pass — one full-price adult covers up to 2 children.'};if(!qty.child)return {amt:0,ok:false,note:'ℹ️ Add Child Fun Passes — 2 children go free per full-price adult.'};var ll=littleLegends();var msg;if(ll.extra>0){var need=Math.ceil(ll.C/2);msg='✔️ '+ll.free+' child(ren) FREE with '+ll.qualAdults+' full-price adult(s). '+ll.extra+' extra child(ren) at regular price — add '+(need-ll.A)+' more adult(s) to free all '+ll.C+'. Adult 15% online discount not applicable.';}else{msg='✔️ All '+ll.free+' child(ren) FREE with '+ll.qualAdults+' full-price adult(s). Adult 15% online discount not applicable on Little Legends.';}return {amt:ll.saving,ok:true,note:msg};}
 case 'bogo-samecat':{var bf=birthdayFree();if(!bf)return {amt:0,ok:false,note:'🎂 Add one more ticket from the same category to use the Birthday Buddy Treat.'};if(bdayDob&&selDate&&bdayDob.slice(5,7)!==selDate.slice(5,7))return {amt:0,ok:false,note:'🎂 This offer is available only for visits during the birthday person’s birth month.'};return {amt:bf,ok:true,note:'🎂 1 same-category ticket FREE for the birthday companion — valid DOB proof required at entry.'};}
 case 'b2g1-samecat':{var r2=b2g1SameCat(o.cats);if(!r2.amt)return {amt:0,ok:false,note:'ℹ️ Add 3+ passes of the same category — buy 2 get 1 free.'};return {amt:r2.amt,ok:true,note:'✔️ '+r2.free+' ticket(s) FREE (all three same category).'};}
 case 'info-double':{if(!qty.dfpa&&!qty.dfpc)return {amt:0,ok:false,note:'ℹ️ Add a Double Fun Pass to enjoy the two-day special price.'};return {amt:0,ok:true,note:'✅ Double Fun Pass special pricing applied (Adult ₹1,313 · Child ₹1,128).'};}
}return {amt:0,ok:false,note:''};}
function bestOffer(){if(!selDate)return null;var best=null,bestAmt=-1,bestPen=9;offers.forEach(function(o){if(!dateEligible(o,selDate))return;if(o.needsDob||o.needsId)return;var r=evalOffer(o);if(!r.ok||r.amt<=0)return;var pen=0;if(r.amt>bestAmt||(r.amt===bestAmt&&pen<bestPen)){bestAmt=r.amt;bestPen=pen;best=o;}});return best;}
const prices={adult:828.75,child:648.55,senior:648.55,student:780,dfpa:1313,dfpc:1128,veg:250,nonveg:300,kids:199,snacks:149};
const mrp={adult:975,child:763,senior:763};
const labels={adult:"Adult Fun Pass",child:"Child Fun Pass",senior:"Senior Citizen Fun Pass",student:"College Student ID Fun Pass",dfpa:"Double Fun Pass — Adult",dfpc:"Double Fun Pass — Child",veg:"Veg Meal",nonveg:"Non-veg Meal",kids:"Kids Happy Meal",snacks:"Snack & Beverage Pack"};
let qty={adult:1,child:0,senior:0,student:0,dfpa:0,dfpc:0,veg:0,nonveg:0,kids:0,snacks:0};
const FOODKEYS=['veg','nonveg','kids','snacks'];
function foodTotal(){return FOODKEYS.reduce(function(s,k){return s+(qty[k]||0)*prices[k];},0);}
let selOffer=null, selDate='', calY, calM;
const fmt=v=>'₹'+(Math.round(v*100)/100).toLocaleString('en-IN',{maximumFractionDigits:2});

/* ---------------- navigation ---------------- */
function go(p){
 document.querySelectorAll('.page').forEach(x=>x.classList.remove('visible'));
 document.getElementById('page-'+p).classList.add('visible');
 document.body.classList.toggle('portal-mode',p==='optportal');
 if(p==='optportal'){document.getElementById('op-agency').textContent=opAgencyName();renderOpNav();renderOpView('dashboard');}
 document.querySelectorAll('.nav-link').forEach(x=>x.classList.toggle('active',x.dataset.nav===p));
 window.scrollTo({top:0,behavior:'smooth'});
 if(p==='book') renderBooking();
}
function goD(p){toggleDrawer(false);go(p);}
function toggleDrawer(o){document.getElementById('drawer').classList.toggle('open',o);document.getElementById('overlay').classList.toggle('show',o);}

/* ---------------- rides ---------------- */
function rideCard(r){
 const media=r.ph&&PH[r.ph]?`<img src="${PH[r.ph]}" alt="${r.n}" loading="lazy">`:(r.e?r.e:(IC[r.i]?IC[r.i]():'🎢'));
 return `<div class="card" data-c="${r.c}" data-n="${r.n}" onclick="toast('▶ '+this.dataset.n+' — ride video plays here')">
 <div class="card-media ${r.bg}">${media}</div>
 <div class="card-body"><span class="tag">${r.m}</span><h3>${r.n}</h3><p>${r.d}</p></div></div>`;}
const hr=document.getElementById('home-rides'); if(hr) hr.innerHTML=[8,17,1,32].map(i=>rides[i]).map(rideCard).join('');
const _k=document.querySelector('.hero-raja'), _s=document.querySelector('.hero-sepoy');
document.querySelectorAll('.procl-king,.story-king').forEach(el2=>{if(_k)el2.src=_k.src;});
document.querySelectorAll('.story-sepoy').forEach(el2=>{if(_s)el2.src=_s.src;});
document.getElementById('ride-grid').innerHTML=rides.map(rideCard).join('');
document.querySelectorAll('#ride-pills .pill').forEach(p=>p.onclick=()=>{
 document.querySelectorAll('#ride-pills .pill').forEach(x=>x.classList.remove('active'));
 p.classList.add('active');
 document.querySelectorAll('#ride-grid .card').forEach(c=>{
  c.style.display=(p.dataset.f==='all'||c.dataset.c===p.dataset.f)?'':'none';});
});

/* ---------------- offers ---------------- */
function offerAcc(o){
 var t=todayISO(), st=offStatus(o,t), elig=dateEligible(o,selDate), open=(selOffer&&selOffer.id===o.id);
 var tag = elig? '' : (st==='upcoming'?' · UPCOMING':st==='expired'?' · EXPIRED':st==='inactive'?' · INACTIVE':(selDate?' · NOT ELIGIBLE':''));
 var nx=firstEligibleVisit(o,t);
 var btn = elig ? '<button class="apply" onclick="applyOffer(\''+o.id+'\')">Apply &amp; pick date ➜</button>' : '<button class="apply" disabled>'+(st==='expired'?'Offer ended':(nx?('Select '+nx):'Not available'))+'</button>';
 return '<div class="offer-acc'+(open?' open':'')+(elig?'':' offdim')+'" style="--ac:'+ocAccent(o)+'">'+
  '<button class="offer-acc-head" onclick="toggleOffer(\''+o.id+'\')" aria-expanded="'+open+'">'+
   '<span class="oa-badge">'+o.badge+tag+'</span>'+
   '<span class="oa-name">'+o.name+'</span>'+
   '<span class="oa-price">'+priceTag(o)+'</span>'+
   '<span class="oa-chev">'+(open?'▲':'▼')+'</span>'+
  '</button>'+
  '<div class="offer-acc-body"><p>'+o.desc+'</p><p class="oa-dates">\U0001F4C5 '+o.dateLabel+'</p>'+btn+'</div></div>';
}
var OFFER_AC={online15:'#2AA79B',student:'#8FA31E',kids:'#7A3B9E',independence:'#E28A2A',birthday:'#D6316B',midweek:'#4E86C6',friendship:'#D53625',double:'#E3A81E'};
function ocAccent(o){return (o&&OFFER_AC[o.id])||'#7A3B9E';}
function offerScroll(o){
 var t=todayISO(),st=offStatus(o,t);
 var applyBtn=(st==='active')?'<button class="sc-apply" onclick="event.stopPropagation();applyOffer(\''+o.id+'\')">Unfurl &amp; Book ➜</button>':'<button class="sc-apply" disabled>'+(st==='upcoming'?('Upcoming · from '+(firstEligibleVisit(o,t)||'soon')):'Not available')+'</button>';
 return '<div class="scrollcard" id="sc-'+o.id+'" style="--ac:'+ocAccent(o)+'">'
  +'<button class="scrollcard-head" onclick="toggleScroll(\''+o.id+'\')" aria-expanded="false"><span class="sc-seal">VGP</span><span class="sc-title">'+o.name+'</span><span class="sc-tag">'+priceTag(o)+'</span><span class="sc-chev">▾</span></button>'
  +'<div class="scrollcard-body"><div class="sc-inner"><div class="sc-code">Coupon code: <b>'+(o.code||'')+'</b></div><p>'+o.desc+'</p><p class="sc-dates">\U0001F4C5 '+o.dateLabel+'</p>'+applyBtn+'</div></div></div>';
}
function toggleScroll(id){var el=document.getElementById('sc-'+id);if(!el)return;el.classList.toggle('open');var hd=el.querySelector('.scrollcard-head');if(hd)hd.setAttribute('aria-expanded',el.classList.contains('open'));}
function renderOffers(){
 var t=todayISO();
 var g=document.getElementById('offer-grid');
 if(g){
  var avail=offers.filter(function(o){return offStatus(o,t)==='active';});
  var upc=offers.filter(function(o){return offStatus(o,t)==='upcoming';});
  var html='<p class="offers-lead">Tap a scroll to unfurl the offer details.</p><h3 class="offers-sec-h">🎫 Available now</h3>';
  html+= avail.length? '<div class="scroll-list">'+avail.map(offerScroll).join('')+'</div>':'<p class="no-offer">No offers are available right now. Regular tickets are always available for booking.</p>';
  if(upc.length){html+='<h3 class="offers-sec-h">⏳ Upcoming offers</h3><div class="scroll-list">'+upc.map(offerScroll).join('')+'</div>';}
  g.innerHTML=html;
 }
 var pl=document.getElementById('plan-offers'); if(!pl) return;
 if(selDate){
  var elig=offers.filter(function(o){return dateEligible(o,selDate);});
  pl.innerHTML= elig.length? elig.map(offerAcc).join(''):'<p class="no-offer">No offers are available for your selected visit date. You can continue booking at the regular ticket price or <a onclick="clearDate()">select another date</a> to explore available offers.</p>';
 } else { pl.innerHTML=offers.map(offerAcc).join(''); }
 var hint=document.getElementById('offer-hint');
 if(hint) hint.textContent = selDate? ('Offers available for '+selDate) : (selOffer? ('Calendar shows dates for '+selOffer.name) : 'Pick a date or tap an offer to see valid dates');
}
function applyOffer(id){
 selOffer=offers.find(function(o){return o.id===id;});
 go('book');
 renderOffers(); renderCal();
 if(!selDate){bookStep(1);toast('📅 Now pick a highlighted date for this offer');return;}
 if(!dateOk(id,selDate)){selDate='';renderOffers();renderCal();bookStep(1);toast('📅 Pick a date valid for this offer');return;}
 bookStep(2);toast('🎁 "'+selOffer.name+'" applied — choose your tickets');
}
function toggleOffer(id){
 if(selOffer&&selOffer.id===id){selOffer=null;}
 else{selOffer=offers.find(function(o){return o.id===id;}); if(selDate&&!dateOk(id,selDate)) selDate='';}
 renderOffers(); renderCal();
}
function clearDate(){selDate='';renderOffers();renderCal();}
function clearOffer(){selOffer=null;renderOffers();renderCal();}

/* ---------------- calendar (date right panel) ---------------- */
const MN=['January','February','March','April','May','June','July','August','September','October','November','December'];
function pad(n){return (n<10?'0':'')+n}
function iso(y,m,d){return y+'-'+pad(m+1)+'-'+pad(d)}
function todayISO(){try{return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata'}).format(new Date());}catch(_){var t=new Date();return iso(t.getFullYear(),t.getMonth(),t.getDate());}}
function renderCal(){
 const c=document.getElementById('cal'); if(!c) return;
 const t=new Date(); if(calY===undefined){calY=t.getFullYear();calM=t.getMonth();}
 const first=new Date(calY,calM,1).getDay(), days=new Date(calY,calM+1,0).getDate();
 const atCur=(calY===t.getFullYear()&&calM===t.getMonth());
 let h=`<div class="cal-head"><button class="cal-nav" ${atCur?'disabled':''} onclick="calShift(-1)">‹</button><b>${MN[calM]} ${calY}</b><button class="cal-nav" onclick="calShift(1)">›</button></div>`;
 if(selOffer) h+=`<p class="cal-filter">📅 Dates for <b>${selOffer.name}</b> · <a onclick="clearOffer()">show all</a></p>`;
 h+='<div class="cal-grid">'+['SUN','MON','TUE','WED','THU','FRI','SAT'].map(d=>`<span class="dow">${d}</span>`).join('');
 for(let i=0;i<first;i++)h+='<span></span>';
 for(let d=1;d<=days;d++){
  const dt=iso(calY,calM,d);
  const past=dt<todayISO();
  const okOffer=selOffer? dateOk(selOffer.id,dt):true;
  const disabled=past||!okOffer;
  const cls='day'+(dt===selDate?' sel':'')+(selOffer&&okOffer?' okday':'');
  h+=`<button class="${cls}" ${disabled?'disabled':''} onclick="pickDate('${dt}')">${d}</button>`;
 }
 c.innerHTML=h+'</div>';
}
function calShift(v){calM+=v; if(calM<0){calM=11;calY--} if(calM>11){calM=0;calY++} renderCal();}
function pickDate(dt){selDate=dt;if(selOffer&&!dateEligible(selOffer,selDate)){var nm=selOffer.name;selOffer=null;toast('Your selected offer ('+nm+') is not valid for the new visit date. The best available offer will be applied for the updated booking.');}renderCal();renderOffers();}
function proceedDate(){ if(!selDate){toast('📅 Please pick your visit date first');return;} bookStep(2); }

/* ---------------- booking ---------------- */
function chg(k,v){qty[k]=Math.max(0,qty[k]+v);document.getElementById('q-'+k).textContent=qty[k];revalidateOffer();updateLiveTotal();updateLLHint();}
function revalidateOffer(){if(selOffer&&(!dateEligible(selOffer,selDate)||!evalOffer(selOffer).ok)){var nm=selOffer.name;selOffer=null;toast('ℹ️ "'+nm+'" no longer matches your ticket selection — the best available offer will be re-applied at checkout.');}}
function updateLLHint(){var el=document.getElementById('ll-hint');if(!el)return;if(!selOffer||selOffer.id!=='kids'||!qty.child){el.style.display='none';return;}var ll=littleLegends();el.style.display='block';if(ll.extra>0){var need=Math.ceil(ll.C/2);el.innerHTML='👑 <b>Little Legends:</b> one full-price adult covers 2 children. '+ll.free+' child(ren) get the offer; '+ll.extra+' charged at regular price. Add <b>'+(need-ll.A)+'</b> more full-price adult(s) to extend the benefit to all '+ll.C+'.<br><i>The 15% online discount is not applicable on the qualifying adult ticket.</i>';}else{el.innerHTML='👑 <b>Little Legends:</b> all '+ll.C+' child(ren) qualify with '+ll.qualAdults+' full-price adult(s).<br><i>The 15% online discount is not applicable on the qualifying adult ticket(s).</i>';}}
function gotoStep(n){ if(n>=2 && !selDate){toast('📅 Please pick your visit date first');return;} bookStep(n); }
function updateLiveTotal(){
 var tix=ticketSubtotal();
 var food=foodTotal();
 var n=['adult','child','senior','student','dfpa','dfpc'].reduce(function(s,k){return s+qty[k];},0);
 var txt=(selOffer?('🎁 '+selOffer.name+' · '):'')+'🧮 '+n+' ticket'+(n===1?'':'s')+(food?' + food':'')+' · Subtotal '+fmt(tix+food)+' (before tax)';
 document.querySelectorAll('.live-total').forEach(function(el){el.textContent=txt;});
}
function bookStep(n){
 for(let i=1;i<=4;i++){
  document.getElementById('bstep'+i).style.display=(i===n)?'':'none';
  const s=document.getElementById('st'+i);
  s.className='step'+(i<n?' done':i===n?' now':'');
 }
 if(n===1){renderCal();renderOffers();}
 if(n===4) renderCheckout();
 updateLiveTotal();updateLLHint();
 document.getElementById('page-book').scrollIntoView({behavior:'smooth'});
}
function renderBooking(){bookStep(selOffer&&selDate?4:1);}
function ticketSubtotal(){return ['adult','child','senior','student','dfpa','dfpc'].reduce((s,k)=>s+qty[k]*prices[k],0);}
function buy2get1(){
 var keys=['adult','child','senior','student','dfpa','dfpc'], arr=[];
 keys.forEach(function(k){for(var i=0;i<qty[k];i++)arr.push(prices[k]);});
 if(arr.length<3) return null;
 arr.sort(function(a,b){return a-b;});
 var free=Math.floor(arr.length/3), amt=0, i;
 for(i=0;i<free;i++)amt+=arr[i];
 return {free:free,amt:amt};
}
function offerDiscount(){ if(!selOffer) return {amt:0,note:''}; var r=evalOffer(selOffer); return {amt:r.amt,note:r.note}; }
var CONV_MIN=40, CONV_PCT=0.02;
function convCfg(){try{var c=JSON.parse(localStorage.getItem('ukdConvFee')||'null');if(c){return {min:(c.min!=null?c.min:CONV_MIN),pct:(c.pct!=null?c.pct:CONV_PCT)};}}catch(_){}return {min:CONV_MIN,pct:CONV_PCT};}
function convenienceFee(tixNet,hasTix){if(!hasTix)return {fee:0,pct:0,isMin:false};var cfg=convCfg();var pct=Math.round(tixNet*cfg.pct*100)/100;var fee=Math.max(cfg.min,pct);return {fee:Math.round(fee*100)/100,pct:pct,isMin:pct<cfg.min};}
function grandTotal(){var disc=offerDiscount();var tix=ticketSubtotal();var tixNet=Math.max(0,tix-disc.amt);var food=foodTotal();var conv=convenienceFee(tixNet,tix>0).fee;var sub=tixNet+.18*tixNet+food+.05*food;return {sub:sub,conv:conv,grand:sub+conv,disc:disc.amt};}
function removeOffer(){selOffer=null;renderCheckout();toast('Offer removed — regular price');}
function renderCheckout(){
 if(!selOffer){var b=bestOffer(); if(b) selOffer=b;}
 renderCouponZone();
 document.getElementById('c-date').value=selDate||'Not selected';
 var ao=document.getElementById('applied-offer');
 var disc=offerDiscount();
 if(selOffer){
  var req=(selOffer.needsDob?' · 🎂 carry DOB proof':'')+(selOffer.needsId?' · 🪩 carry ID proof':'');
  ao.style.display='block';
  ao.innerHTML='🎁 Best offer applied automatically: <b>'+esc(selOffer.name)+'</b>'+(selOffer.code?' <span style="opacity:.85">(code '+esc(selOffer.code)+')</span>':'')+(disc.amt?' — you save '+fmt(disc.amt):'')+(disc.note?' · '+disc.note:'')+req+' &nbsp;<a onclick="removeOffer()" style="color:#fff;text-decoration:underline;cursor:pointer">remove</a>';
 } else { ao.style.display='none'; }
 var FOOD=FOODKEYS;
 var rows='',tix=0,food=0,k;
 for(k in qty){ if(qty[k]>0){ var amt=qty[k]*prices[k]; if(FOOD.indexOf(k)>=0) food+=amt; else tix+=amt;
   rows+='<div class="row"><span>'+labels[k]+' × '+qty[k]+'</span><span>'+fmt(amt)+'</span></div>'; } }
 if(selOffer && selOffer.id==='kids'){ var llc=littleLegends(); rows+='<div class="row" style="color:var(--green-deep)"><span>Little Legends: '+llc.free+' child ticket(s) FREE</span><span>− '+fmt(llc.free*prices.child)+'</span></div>'; if(llc.surcharge) rows+='<div class="row" style="color:var(--red)"><span>Adult 15% online discount removed ('+llc.qualAdults+' × '+fmt(mrp.adult-prices.adult)+')</span><span>+ '+fmt(llc.surcharge)+'</span></div>'; if(llc.extra) rows+='<div class="row"><span>'+llc.extra+' regular child ticket(s) — offer limit reached</span><span>at regular price</span></div>'; } else if(disc.amt){ rows+='<div class="row" style="color:var(--green-deep)"><span>Offer: '+esc(selOffer.name)+'</span><span>− '+fmt(disc.amt)+'</span></div>'; }
 var tixNet=Math.max(0,tix-disc.amt);
 var gstT=.18*tixNet, gstF=.05*food, sub=tixNet+gstT+food+gstF;
 var cf=convenienceFee(tixNet,tix>0), conv=cf.fee;
 if(tixNet) rows+='<div class="row"><span>GST on tickets (18%)</span><span>+ '+fmt(gstT)+'</span></div>';
 if(food) rows+='<div class="row"><span>GST on food (5%)</span><span>+ '+fmt(gstF)+'</span></div>';
 if(tix>0) rows+='<div class="row"><span>Convenience fee — '+(cf.isMin?'minimum charge':'2%')+' <span class="cf-i" title="A convenience fee of ₹40 or 2% of the discounted ticket value, whichever is higher, applies per booking. Applicable taxes may be charged separately.">ⓘ</span></span><span>+ '+fmt(conv)+'</span></div>';
 if(selOffer&&selOffer.code){rows+='<div class="row"><span>Coupon code</span><span>'+esc(selOffer.code)+'</span></div>';}
 if(selOffer){rows+='<div class="row" style="font-size:.76rem;color:var(--purple)"><span>Displayed prices include the 15% online discount · one promotional offer per booking</span><span></span></div>';}
 rows+='<div class="row total"><span>Total payable</span><span>'+fmt(sub+conv)+'</span></div>';
 document.getElementById('summary').innerHTML=rows;
}
function esc(s){return String(s).replace(/[<>&"]/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];});}
function validEmail(x){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(x);}
function validPhone(x){return /^[+]?\d[\d\s-]{7,14}$/.test(x);}
function offerSaving(o){if(!dateEligible(o,selDate))return null;var r=evalOffer(o);return r.ok?r.amt:null;}
function online15Saving(){var s=0;['adult','child','senior'].forEach(function(k){s+=qty[k]*((mrp[k]||prices[k])-prices[k]);});return s;}
function couponSearch(){var q=((document.getElementById('coupon-search')||{}).value||'').trim().toLowerCase();document.querySelectorAll('#coupon-zone .cz-card').forEach(function(c){c.style.display=(!q||(c.getAttribute('data-search')||'').indexOf(q)>=0)?'':'none';});}
function czCard(x,opts){opts=opts||{};var o=x.o,sel=(selOffer&&selOffer.id===o.id);var benefit;
 if(o.id==='online15'){benefit=priceTag(o)+' &middot; <span class="cz-save">already included — you saved '+fmt(online15Saving())+'</span>';}
 else{benefit=priceTag(o)+(x.amt!=null?' &middot; <span class="cz-save">You save '+fmt(x.amt)+'</span>':'');}
 return '<div class="cz-card '+o.bg+(sel?' cz-best':'')+'" data-search="'+esc((o.name+' '+(o.code||'')).toLowerCase())+'">'+
  (opts.badge?'<span class="cz-tag">'+opts.badge+'</span>':'')+
  '<div class="cz-name">'+o.name+'</div>'+
  '<div class="cz-code">'+(o.code||'')+'</div>'+
  '<div class="cz-benefit">'+benefit+'</div>'+
  '<div class="cz-elig">'+o.dateLabel+'</div>'+
  '<button class="apply" onclick="applyOfferCode(\''+o.id+'\')">'+(sel?'✓ Applied':(opts.btn||'Apply This Offer'))+'</button>'+
  '</div>';
}
function couponSelect(){var s=document.getElementById('coupon-select');if(!s||!s.value)return;applyOfferCode(s.value);}
function renderCouponZone(){
 var z=document.getElementById('coupon-zone'); if(!z) return;
 var best=bestOffer();
 var elig=[],reqDetails=[],notElig=[];
 offers.forEach(function(o){
  if(!dateEligible(o,selDate)){notElig.push({o:o,reason:reasonUnavailable(o)});return;}
  var r=evalOffer(o);
  if(!r.ok){notElig.push({o:o,reason:r.note});return;}
  if(o.needsDob||o.needsId){reqDetails.push({o:o,amt:r.amt});}
  else{elig.push({o:o,amt:r.amt});}
 });
 elig.sort(function(a,b){return b.amt-a.amt;});
 function sel(id){return (selOffer&&selOffer.id===id)?' selected':'';}
 var html='<h3 class="cz-h">Apply an Offer or Coupon Code</h3>';
 html+='<label class="cz-lab" for="coupon-select">Select an offer or coupon</label>';
 html+='<div class="cz-dd"><select id="coupon-select" onchange="couponSelect()"><option value="">— Choose an offer or coupon —</option>';
 if(best){var br=evalOffer(best);html+='<optgroup label="⭐ Best offer for you"><option value="'+best.id+'"'+sel(best.id)+'>'+best.name+' ('+best.code+') — save '+fmt(br.amt)+'</option></optgroup>';}
 var others=elig.filter(function(x){return !best||x.o.id!==best.id;});
 if(others.length){html+='<optgroup label="Other eligible offers">'+others.map(function(x){return '<option value="'+x.o.id+'"'+sel(x.o.id)+'>'+x.o.name+' ('+x.o.code+') — save '+fmt(x.amt)+'</option>';}).join('')+'</optgroup>';}
 if(reqDetails.length){html+='<optgroup label="Complete details to unlock">'+reqDetails.map(function(x){return '<option value="'+x.o.id+'"'+sel(x.o.id)+'>'+x.o.name+' ('+x.o.code+')</option>';}).join('')+'</optgroup>';}
 if(notElig.length){html+='<optgroup label="Not eligible for this booking">'+notElig.map(function(x){var rr=esc(String(x.reason||'').replace(/^[^A-Za-z0-9]+/,'')).slice(0,44);return '<option value="'+x.o.id+'" disabled>'+x.o.name+' — '+rr+'</option>';}).join('')+'</optgroup>';}
 html+='</select><button class="btn-next" onclick="couponSelect()">Apply</button></div>';
 html+='<div class="cz-manual"><input id="coupon-search" placeholder="Or type a coupon code" onkeydown="if(event.key===\'Enter\')applyCoupon()"><button class="btn-back" onclick="applyCoupon()">Apply Code</button></div>';
 if(!best&&!others.length&&!reqDetails.length){html+='<p class="no-offer">No offers are available for your selected visit date and ticket combination. You can continue booking at the regular ticket price.</p>';}
 if(selOffer&&selOffer.id==='birthday'){html+='<div class="cz-bday"><b>🎂 Birthday Buddy Treat — eligibility</b>'
 +'<p class="cz-elig" style="color:var(--green-deep)">Celebrate during your birthday month! Buy one eligible ticket and bring one favourite person free (same category). Only one Birthday Buddy Treat can be redeemed per booking.</p>'
 +'<div class="field"><label for="bd-name">Birthday person’s full name</label><input id="bd-name" onchange="bdaySet()" value="'+esc(bdayName)+'" placeholder="Full name as per ID"></div>'
 +'<div class="field"><label for="bd-dob">Date of birth</label><input id="bd-dob" type="date" onchange="bdaySet()" value="'+bdayDob+'"></div>'
 +'<div class="field"><label for="bd-companion">Companion’s name (free ticket)</label><input id="bd-companion" onchange="bdaySet()" value="'+esc(bdayCompanion)+'" placeholder="Person joining free"></div>'
 +'<label class="cz-check"><input type="checkbox" id="bd-ok" onchange="bdaySet()"'+(bdayOk?' checked':'')+'> I confirm that the birthday person’s name and date of birth are correct. I understand that valid original ID proof must be presented at the park entrance. If the details cannot be verified, the complimentary ticket will be converted into a regular paid ticket and the balance must be paid before entry.</label>'
 +'<p class="cz-warn">Original date-of-birth proof must be presented at entry. The birthday person must be physically present. ID verification status will show as “Pending” on your ticket until checked at the gate.</p></div>';}
 html+='<p class="cz-policy">Only one VGP promotional ticket offer or coupon can be applied per booking. Promotional ticket offers cannot be combined with each other. Regular-priced food, parking, lockers, merchandise and other paid add-ons may be added. Partner-funded bank or payment cashback may apply separately, subject to campaign terms.</p>';
 z.innerHTML=html;
}
function applyCoupon(){
 var el=document.getElementById('coupon-input'); if(!el)return;
 var code=el.value.trim().toUpperCase(); if(!code){toast('Enter a coupon code');return;}
 var o=offers.find(function(x){return (x.code||'').toUpperCase()===code;});
 if(!o){toast('❌ Invalid coupon code — please check and try again.');return;}
 if(offStatus(o,todayISO())==='expired'){toast('This coupon has expired. Please select another available offer.');return;}
 if(!dateEligible(o,selDate)||!evalOffer(o).ok){toast('This coupon is valid, but it cannot be applied to the selected date, ticket category or ticket quantity.');return;}
 var replacing=(selOffer&&selOffer.id!==o.id);
 selOffer=o; renderCheckout();
 toast((replacing?'Replaced existing offer — one per booking. ':'')+'✅ Coupon applied. You saved '+fmt(evalOffer(o).amt)+'.');
}
function applyOfferCode(id){
 var o=offers.find(function(x){return x.id===id;}); if(!o)return;
 if(!dateEligible(o,selDate)||!evalOffer(o).ok){toast('Not eligible for the selected date or tickets.');return;}
 var replacing=(selOffer&&selOffer.id!==id);
 selOffer=o; renderCheckout();
 toast((replacing?'Only one promotional offer per booking — replaced. ':'')+'🎁 '+o.name+' applied — you save '+fmt(evalOffer(o).amt)+'.');
}
var API_BASE=(location.protocol==='file:'?'http://localhost:4000':'');
function pay(){
 var n=document.getElementById('c-name').value.trim();
 var e=document.getElementById('c-email').value.trim();
 var p=document.getElementById('c-phone').value.trim();
 if(!selDate){toast('📅 Please pick a visit date');bookStep(1);return;}
 var tixCount=['adult','child','senior','student','dfpa','dfpc'].reduce(function(s,k){return s+qty[k];},0);
 if(tixCount<1){toast('🎫 Add at least one ticket');bookStep(2);return;}
 if(!n){toast('⚠️ Please enter your name');document.getElementById('c-name').focus();return;}
 if(!validEmail(e)){toast('📧 Enter a valid email address');document.getElementById('c-email').focus();return;}
 if(!validPhone(p)){toast('📱 Enter a valid contact number');document.getElementById('c-phone').focus();return;}
 if(!document.getElementById('media-consent')||!document.getElementById('media-consent').checked){toast('📸 Please accept the media & data consent to continue');bookStep(4);return;}
 if(selOffer && !dateEligible(selOffer,selDate)){selOffer=null;renderCheckout();toast('⚠️ Offer no longer valid — total updated to regular price');return;}
 var bdayRec=null;
 if(selOffer && selOffer.id==='birthday'){var bn=(document.getElementById('bd-name')||{}).value||'',bd=(document.getElementById('bd-dob')||{}).value||'',bcomp=(document.getElementById('bd-companion')||{}).value||'',bok=(document.getElementById('bd-ok')||{}).checked;if(!bn.trim()){toast('🎂 Enter the birthday person’s name');return;}if(!bd){toast('🎂 Enter the birthday person’s date of birth');return;}if(bd.slice(5,7)!==selDate.slice(5,7)){toast('🎂 This offer is available only for visits during the birthday person’s birth month.');return;}if(!bok){toast('🎂 Please accept the birthday declaration.');return;}var bkey=bn.trim().toLowerCase().replace(/\s+/g,' ')+'|'+bd+'|'+selDate.slice(0,7);bdayRec={key:bkey,name:bn.trim(),dob:bd,companion:bcomp.trim()};}
 var _dev=currentDevice();var _geo=currentGeo();var payload={date:selDate,cart:Object.assign({},qty),customer:{name:n,email:e,phone:p},device:_dev.label,deviceBrand:_dev.brand,deviceType:_dev.type,location:_geo.label||'',country:_geo.country||'',visitorId:getCookie('vgp_vid'),mediaConsent:true};
 if(selOffer) payload.offerId=selOffer.id;
 if(bdayRec) payload.birthday={name:bdayRec.name,dob:bdayRec.dob,companion:bdayRec.companion,declaration:true};
 toast('⏳ Confirming your booking…');
 fetch(API_BASE+'/api/bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
  .then(function(r){return r.json().then(function(jj){return {ok:r.ok,j:jj};});})
  .then(function(res){
    if(!res.ok){ toast('⚠️ '+(res.j.error||'Booking could not be completed.')); return; }
    var b=res.j;
    try{var _all=JSON.parse(localStorage.getItem('ukdBookings')||'[]');_all.push({ref:b.ref,date:selDate,total:b.breakdown.total,offer:b.breakdown.offer,device:currentDevice().label,deviceBrand:currentDevice().brand,location:currentGeo().label||'',country:currentGeo().country||'',visitorId:getCookie('vgp_vid'),mediaConsent:true,verify:b.verify,ts:new Date().toISOString()});localStorage.setItem('ukdBookings',JSON.stringify(_all));}catch(_){}
    showConfirmation({ref:b.ref,total:b.breakdown.total,qr:b.qrPayload,breakdown:b.breakdown,cart:Object.assign({},qty),offerName:(b.breakdown.offer||'No offer (regular price)'),bperson:(b.birthday?b.birthday.name:null),name:n,email:e,server:true});
  })
  .catch(function(){ payLocal(n,e,p,bdayRec); });
}
function payLocal(n,e,p,bdayRec){
 if(bdayRec){try{var breg=JSON.parse(localStorage.getItem('ukdBdayRedeem')||'[]');if(breg.indexOf(bdayRec.key)>=0){toast('🎂 This birthday offer has already been used by the selected birthday person during the current birthday month.');return;}}catch(_){}}
 var grand=grandTotal().grand;
 var ref='UKD-'+(Date.now().toString(36)+Math.random().toString(36).slice(2,5)).toUpperCase().slice(-8);
 var offerName=selOffer?selOffer.name:'No offer (regular price)';
 var _dv=currentDevice();var _gl=currentGeo();var booking={ref:ref,name:n,email:e,phone:p,date:selDate,total:grand,items:Object.assign({},qty),offer:offerName,birthday:bdayRec,verify:(bdayRec?'Pending ID Verification':null),device:_dv.label,deviceBrand:_dv.brand,location:_gl.label||'',country:_gl.country||'',visitorId:getCookie('vgp_vid'),mediaConsent:true,ts:new Date().toISOString()};
 try{var all=JSON.parse(localStorage.getItem('ukdBookings')||'[]');all.push(booking);localStorage.setItem('ukdBookings',JSON.stringify(all));}catch(_){}
 if(bdayRec){try{var breg2=JSON.parse(localStorage.getItem('ukdBdayRedeem')||'[]');breg2.push(bdayRec.key);localStorage.setItem('ukdBdayRedeem',JSON.stringify(breg2));}catch(_){}}
 var qtok=(Date.now().toString(36)+Math.random().toString(36).slice(2,10)).toUpperCase();
 var qp='VGP-TICKET|'+qtok+'|'+ref+'|'+selDate+'|INR'+grand.toFixed(2)+(bdayRec?('|Birthday:'+bdayRec.name+'|Verify:Pending'):'');
 showConfirmation({ref:ref,total:grand,qr:qp,breakdown:buildBreakdown(),cart:Object.assign({},qty),offerName:offerName,bperson:(bdayRec?bdayRec.name:null),name:n,email:e,server:false});
}
function buildBreakdown(){
 var disc=offerDiscount();var FOOD=FOODKEYS;var tix=0,food=0,k;
 for(k in qty){if(qty[k]>0){var a=qty[k]*prices[k];if(FOOD.indexOf(k)>=0)food+=a;else tix+=a;}}
 var tixNet=Math.max(0,Math.round((tix-disc.amt)*100)/100);
 var gstT=Math.round(0.18*tixNet*100)/100,gstF=Math.round(0.05*food*100)/100;
 var cf=convenienceFee(tixNet,tix>0);
 var total=Math.round((tixNet+gstT+food+gstF+cf.fee)*100)/100;
 return {ticketSubtotal:Math.round(tix*100)/100,discount:Math.round(disc.amt*100)/100,offer:(selOffer?selOffer.name:null),couponCode:(selOffer?selOffer.code:null),discountedTicketValue:tixNet,gstTickets:gstT,food:Math.round(food*100)/100,gstFood:gstF,convenienceFee:cf.fee,convenienceFeeType:(cf.isMin?'minimum':'2%'),total:total,saving:Math.round(disc.amt*100)/100};
}
function showConfirmation(o){
 var bd=o.breakdown||buildBreakdown();var cart=o.cart||qty;
 var qurl='https://api.qrserver.com/v1/create-qr-code/?size=200x200&margin=6&data='+encodeURIComponent(o.qr);
 var today=(new Date()).toLocaleDateString('en-GB');
 var LBL={adult:'Adult Fun Pass',child:'Child Fun Pass',senior:'Senior Fun Pass',student:'Student Fun Pass',dfpa:'Double Fun Pass — Adult',dfpc:'Double Fun Pass — Child',veg:'Veg Meal',nonveg:'Non-veg Meal'};
 var rows='';
 ['adult','child','senior','student','dfpa','dfpc','veg','nonveg'].forEach(function(k){if(cart[k]>0){rows+='<tr><td>'+LBL[k]+'</td><td>'+cart[k]+'</td><td>'+fmt(prices[k])+'</td><td>'+fmt(cart[k]*prices[k])+'</td></tr>';}});
 if(bd.discount>0)rows+='<tr class="inv-disc"><td colspan="3">Offer: '+esc(bd.offer||'')+(bd.couponCode?' ('+esc(bd.couponCode)+')':'')+'</td><td>− '+fmt(bd.discount)+'</td></tr>';
 if(bd.gstTickets>0)rows+='<tr><td colspan="3">GST on tickets (18%)</td><td>'+fmt(bd.gstTickets)+'</td></tr>';
 if(bd.gstFood>0)rows+='<tr><td colspan="3">GST on food (5%)</td><td>'+fmt(bd.gstFood)+'</td></tr>';
 rows+='<tr><td colspan="3">Convenience fee ('+(bd.convenienceFeeType==='minimum'?'min ₹40':'2%')+')</td><td>'+fmt(bd.convenienceFee)+'</td></tr>';
 rows+='<tr class="inv-tot"><td colspan="3">Total Payable</td><td>'+fmt(bd.total)+'</td></tr>';
 var bhtml=o.bperson?'<div class="inv-bday">🎂 Birthday Buddy Treat · Birthday Person: <b>'+esc(o.bperson)+'</b> · Complimentary tickets: <b>1</b> · Verification: <b>Pending ID Verification</b> (original DOB proof required at entry)</div>':'';
 document.getElementById('bstep4').innerHTML=
  '<div id="invoice" class="invoice">'
  +'<div class="inv-head"><div class="inv-brand"><span class="inv-logo">👑</span><div><b>VGP UNIVERSAL KINGDOM</b><br><span>Family Amusement &amp; Water Park · ECR, Chennai</span></div></div>'
  +'<div class="inv-meta"><span class="inv-tag">TAX INVOICE · E-TICKET</span><br>Invoice: <b>INV-'+o.ref+'</b><br>Date: '+today+'<br>GSTIN: 33ABCDE1234F1Z5</div></div>'
  +'<div class="inv-parties"><div><span class="inv-lab">Billed to</span><br><b>'+esc(o.name)+'</b><br>'+esc(o.email)+'</div><div><span class="inv-lab">Visit details</span><br>Visit date: <b>'+esc(selDate)+'</b><br>Booking ID: <b>'+o.ref+'</b></div></div>'
  +'<table class="inv-table"><tr><th>Description</th><th>Qty</th><th>Rate</th><th>Amount</th></tr>'+rows+'</table>'
  +(bd.saving>0?'<div class="inv-save">You saved '+fmt(bd.saving)+' with '+esc(bd.offer||'the applied offer')+'</div>':'')
  +bhtml
  +'<div class="inv-foot"><div class="inv-qr"><img src="'+qurl+'" alt="Unique QR e-ticket for '+o.ref+'" width="150" height="150"><div class="inv-qrc">Scan at entry<br><b>'+o.ref+'</b></div></div>'
  +'<div class="inv-terms"><b>Terms &amp; Conditions</b><br>• No cancellation/postponement after booking.<br>• Entry free for children below 90 cm.<br>• Senior (60+) &amp; students must carry valid ID.<br>• Birthday offers require original DOB proof at entry.<br>• This QR code is unique to this transaction and is verified at the gate.<br>'+(o.server?'✔ Recorded &amp; QR registered on the booking server.':'ℹ Recorded locally (server offline).')+'</div></div>'
  +'</div>'
  +'<div class="conf-actions no-print"><button class="btn-next" onclick="window.print()">🖨 Print / Download PDF</button> <button class="btn-back" onclick="location.reload()">Make another booking</button></div>';
 document.getElementById('bstep4').scrollIntoView({behavior:'smooth',block:'start'});
 toast('🎉 Booking confirmed — '+o.ref);
}
function sendContact(){
 var n=document.getElementById('ct-name').value.trim();
 var e=document.getElementById('ct-email').value.trim();
 var m=document.getElementById('ct-msg').value.trim();
 if(!n){toast('⚠️ Please enter your name');document.getElementById('ct-name').focus();return;}
 if(!validEmail(e)){toast('📧 Enter a valid email');document.getElementById('ct-email').focus();return;}
 if(!m){toast('✍️ Please enter a message');document.getElementById('ct-msg').focus();return;}
 try{var all=JSON.parse(localStorage.getItem('ukdMessages')||'[]');all.push({n:n,e:e,m:m,ts:new Date().toISOString()});localStorage.setItem('ukdMessages',JSON.stringify(all));}catch(_){}
 document.getElementById('ct-name').value='';document.getElementById('ct-email').value='';document.getElementById('ct-msg').value='';
 toast('📨 Thanks '+n+'! Your message was sent.');
}
var OP_NAV=[['dashboard','📊 Dashboard'],['newbooking','🎟 New Booking'],['group','👥 Group Booking'],['bookings','🗂 My Bookings'],['rates','💱 Rates & Offers'],['wallet','👛 Wallet & Payments'],['credit','💳 Credit'],['commission','💰 Commission'],['invoices','🧾 Invoices'],['reports','📈 Reports'],['profile','🏢 Agency Profile'],['support','🎧 Support']];
function opAgencyName(){try{var ops=JSON.parse(localStorage.getItem('ukdOperators')||'[]');if(ops.length&&ops[ops.length-1].agency)return ops[ops.length-1].agency;var u=JSON.parse(localStorage.getItem('ukdUser')||'null');if(u&&u.user)return (u.user.split('@')[0]);}catch(_){}return 'Partner Agency';}
function openOpPortal(){go('optportal');}
function opLogout(){try{localStorage.removeItem('ukdUser');}catch(_){}if(typeof reflectLogin==='function')reflectLogin();go('home');toast('👋 Logged out');}
function renderOpNav(){var el=document.getElementById('op-nav');if(!el)return;el.innerHTML=OP_NAV.map(function(n){return '<a class="op-navi" data-v="'+n[0]+'" onclick="renderOpView(\''+n[0]+'\')">'+n[1]+'</a>';}).join('');}
function opKpi(t,v,sub,cls){return '<div class="op-kpi '+(cls||'')+'"><div class="op-kv">'+v+'</div><div class="op-kt">'+t+'</div>'+(sub?'<div class="op-ks">'+sub+'</div>':'')+'</div>';}
function opQA(label,view){return '<button class="op-qbtn" onclick="renderOpView(\''+view+'\')">'+label+'</button>';}
function opBadge(t,c){return '<span class="op-badge '+c+'">'+t+'</span>';}
function renderOpView(v){
 document.querySelectorAll('.op-navi').forEach(function(a){a.classList.toggle('active',a.getAttribute('data-v')===v);});
 var m=document.getElementById('op-main');if(!m)return;
 var f={dashboard:opDashboard,newbooking:opNewBooking,group:opGroup,bookings:opBookings,rates:opRates,wallet:opWallet,credit:opCredit,commission:opCommission,invoices:opInvoices,reports:opReports,profile:opProfile,support:opSupport}[v]||opDashboard;
 m.innerHTML=f(); m.scrollTop=0;
}
function opDashboard(){
 return '<div class="op-banner"><h2>Welcome back, '+esc(opAgencyName())+' 👋</h2><p>Manage bookings, guests, payments, vouchers and commissions from one place.</p></div>'
 +'<div class="op-kpis">'+opKpi("Today's bookings","3","","")+opKpi("Upcoming visits","7","next: 24 Aug","")+opKpi("Total guests (month)","1,240","","")+opKpi("Pending payments","₹42,500","1 due 18 Aug","warn")+opKpi("Wallet balance","₹68,300","","good")+opKpi("Available credit","₹1,50,000","of ₹2,00,000","")+opKpi("Commission earned","₹18,450","this month","good")+opKpi("Commission pending","₹7,200","","warn")+'</div>'
 +'<h3 class="op-h">Quick actions</h3><div class="op-qa">'+opQA("🎟 New Booking","newbooking")+opQA("👥 Group Booking","group")+opQA("🗂 Manage Bookings","bookings")+opQA("🎫 Vouchers","bookings")+opQA("👛 Add Funds","wallet")+opQA("💳 Request Credit","credit")+opQA("💰 Commission","commission")+opQA("📈 Reports","reports")+'</div>'
 +'<div class="op-two"><div class="op-panel"><h3 class="op-h">Upcoming bookings</h3><table class="op-table"><tr><th>Group</th><th>Visit</th><th>Guests</th><th>Status</th><th></th></tr>'
 +'<tr><td>ABC School Group</td><td>24 Aug 2026</td><td>120</td><td>'+opBadge("Confirmed","b-ok")+'</td><td><a onclick="toast(\'🎫 Voucher downloaded\')">Voucher</a></td></tr>'
 +'<tr><td>Chennai Family Tours</td><td>18 Aug 2026</td><td>36</td><td>'+opBadge("Awaiting payment","b-warn")+'</td><td><a onclick="renderOpView(\'wallet\')">Pay</a></td></tr>'
 +'<tr><td>Sunrise Corporate</td><td>30 Aug 2026</td><td>80</td><td>'+opBadge("Confirmed","b-ok")+'</td><td><a onclick="toast(\'🎫 Voucher downloaded\')">Voucher</a></td></tr></table></div>'
 +'<div class="op-panel"><h3 class="op-h">Alerts & support</h3><ul class="op-alerts"><li>📄 GST certificate expires in 20 days — <a onclick="renderOpView(\'profile\')">upload</a></li><li>💳 Payment ₹42,500 due 18 Aug — <a onclick="renderOpView(\'wallet\')">pay now</a></li><li>🎉 New offer: Adi Thalubadi live 21 Jul – 12 Aug</li></ul><p class="op-muted" style="margin-top:12px">Partner support: <b>1800-XXX-XXXX</b> · partners@vgp.in</p></div></div>';
}
function opNewBooking(){
 var parks=['VGP Universal Kingdom','VGP Marine Kingdom','Combo — Universal + Marine','VGP Cyber Kingdom','VGP Playy Kingdom'];
 return '<h2 class="op-title">New Booking</h2><p class="op-muted">Book individual or small-group tickets at your contracted operator rates.</p>'
 +'<div class="op-parks">'+parks.map(function(p){return '<button class="op-park" onclick="go(\'book\')">🎢 '+p+'</button>';}).join('')+'</div>'
 +'<div class="op-note">ℹ️ Select a park to open the booking flow (date → tickets → add-ons → guest details → payment → voucher & QR). <b>Operator contracted rates cannot be combined with consumer promotional offers or coupon codes.</b></div>';
}
function opGroup(){
 return '<h2 class="op-title">Group Booking</h2><p class="op-muted">For schools, colleges, corporate, tours and associations. Upload a guest list via Excel/CSV.</p>'
 +'<div class="op-form"><div class="two-col"><div class="field"><label>Group name</label><input placeholder="e.g. ABC School"></div><div class="field"><label>Group category</label><select><option>School</option><option>College</option><option>Corporate</option><option>Tour group</option><option>Association</option></select></div><div class="field"><label>Visit date</label><input type="date"></div><div class="field"><label>Expected arrival</label><input type="time"></div><div class="field"><label>Total guests</label><input type="number" placeholder="e.g. 120"></div><div class="field"><label>Free escorts</label><input type="number" placeholder="e.g. 5"></div><div class="field"><label>Group leader</label><input placeholder="Leader name"></div><div class="field"><label>Leader mobile</label><input type="tel" placeholder="+91"></div></div>'
 +'<div class="field"><label>Upload guest list (Excel/CSV)</label><input type="file" accept=".csv,.xlsx,.xls"></div>'
 +'<div class="op-note">The portal validates minimum group size, free-ticket ratio, guide/escort ratio, meal quantities and capacity before confirming.</div>'
 +'<button class="btn-next cta-green" onclick="toast(\'📩 Group quote request submitted for approval\')">Request Group Quote</button></div>';
}
function opBookingRows(){
 var out='';try{var arr=JSON.parse(localStorage.getItem('ukdBookings')||'[]');arr.slice(-6).reverse().forEach(function(b){out+='<tr><td>'+esc(b.ref||'-')+'</td><td>'+esc(b.date||'-')+'</td><td>VGP Universal</td><td>'+(b.total?fmt(b.total):'-')+'</td><td>'+opBadge("Confirmed","b-ok")+'</td><td>'+esc(b.location||b.country||'—')+'</td><td>'+esc(b.deviceBrand||b.device||'—')+'</td><td><a onclick="toast(\'🎫 Voucher downloaded\')">Voucher</a></td></tr>';});}catch(_){}
 out+='<tr><td>VGP-OP-10231</td><td>24 Aug 2026</td><td>VGP Universal</td><td>₹96,000</td><td>'+opBadge("Voucher issued","b-ok")+'</td><td>Chennai, Tamil Nadu</td><td>Apple iPhone</td><td><a onclick="toast(\'🎫 Voucher downloaded\')">Voucher</a></td></tr>'
 +'<tr><td>VGP-OP-10228</td><td>18 Aug 2026</td><td>Marine Kingdom</td><td>₹42,500</td><td>'+opBadge("Awaiting payment","b-warn")+'</td><td>Bengaluru, Karnataka</td><td>Samsung</td><td><a onclick="renderOpView(\'wallet\')">Pay</a></td></tr>'
 +'<tr><td>VGP-OP-10219</td><td>02 Aug 2026</td><td>Combo</td><td>₹1,28,000</td><td>'+opBadge("Checked in","b-ok")+'</td><td>Hyderabad, Telangana</td><td>Windows PC</td><td><a onclick="toast(\'🧾 Invoice downloaded\')">Invoice</a></td></tr>';
 return out;
}
function opBookings(){return '<h2 class="op-title">My Bookings</h2><div class="op-filters"><input placeholder="Search booking ID / group"><select><option>All status</option><option>Confirmed</option><option>Awaiting payment</option><option>Cancelled</option></select><input type="date"></div><table class="op-table"><tr><th>Booking ID</th><th>Visit</th><th>Park</th><th>Amount</th><th>Status</th><th>Location</th><th>Device</th><th>Action</th></tr>'+opBookingRows()+'</table>';}
function opRates(){
 var r=[['VGP Universal','Adult','₹975','₹720','₹255'],['VGP Universal','Child','₹763','₹560','₹203'],['Marine Kingdom','Adult','₹900','₹660','₹240'],['Combo','Adult','₹1,715','₹1,250','₹465'],['VGP Universal','School (min 30)','₹975','₹520','₹455']];
 return '<h2 class="op-title">Rates & Offers</h2><p class="op-muted">Your confidential B2B contracted net rates. These cannot be edited and cannot be combined with consumer offers.</p>'
 +'<table class="op-table"><tr><th>Park</th><th>Category</th><th>Published</th><th>Net rate</th><th>Your margin</th></tr>'+r.map(function(x){return '<tr><td>'+x[0]+'</td><td>'+x[1]+'</td><td>'+x[2]+'</td><td><b>'+x[3]+'</b></td><td class="op-green">'+x[4]+'</td></tr>';}).join('')+'</table>'
 +'<div class="op-note">Tour Operator rates are special contracted B2B rates and cannot be combined with consumer promotional offers, coupon codes, student, birthday or Buy 2 Get 1 offers.</div>';
}
function opWallet(){return '<h2 class="op-title">Wallet & Payments</h2><div class="op-kpis"><div class="op-kpi good"><div class="op-kv">₹68,300</div><div class="op-kt">Wallet balance</div></div><div class="op-kpi"><div class="op-kv">₹2,40,000</div><div class="op-kt">Paid this month</div></div><div class="op-kpi warn"><div class="op-kv">₹42,500</div><div class="op-kt">Pending</div></div></div>'
 +'<div class="op-qa"><button class="op-qbtn" onclick="toast(\'💳 Redirecting to payment gateway…\')">➕ Add Funds</button><button class="op-qbtn" onclick="toast(\'📄 Statement downloaded\')">Download Statement</button><button class="op-qbtn" onclick="renderOpView(\'credit\')">Use Credit</button></div>'
 +'<h3 class="op-h">Recent transactions</h3><table class="op-table"><tr><th>Date</th><th>Type</th><th>Amount</th><th>Status</th></tr><tr><td>12 Aug</td><td>Add funds (UPI)</td><td>+₹50,000</td><td>'+opBadge("Successful","b-ok")+'</td></tr><tr><td>10 Aug</td><td>Booking VGP-OP-10228</td><td>-₹42,500</td><td>'+opBadge("Pending","b-warn")+'</td></tr><tr><td>05 Aug</td><td>Booking VGP-OP-10219</td><td>-₹1,28,000</td><td>'+opBadge("Successful","b-ok")+'</td></tr></table>';}
function opCredit(){return '<h2 class="op-title">Credit Facility</h2><div class="op-kpis"><div class="op-kpi"><div class="op-kv">₹2,00,000</div><div class="op-kt">Approved limit</div></div><div class="op-kpi good"><div class="op-kv">₹1,50,000</div><div class="op-kt">Available credit</div></div><div class="op-kpi warn"><div class="op-kv">₹50,000</div><div class="op-kt">Utilised · due 25 Aug</div></div></div><div class="op-note">Credit terms: 30 days · auto-block on limit breach · admin override on request.</div><div class="op-qa"><button class="op-qbtn" onclick="toast(\'📩 Credit-increase request sent for approval\')">Request Limit Increase</button><button class="op-qbtn" onclick="toast(\'💰 Redirecting to payment…\')">Pay Outstanding</button><button class="op-qbtn" onclick="toast(\'📄 Credit statement downloaded\')">Download Statement</button></div>';}
function opCommission(){return '<h2 class="op-title">Commission</h2><div class="op-kpis"><div class="op-kpi good"><div class="op-kv">₹18,450</div><div class="op-kt">Earned (month)</div></div><div class="op-kpi warn"><div class="op-kv">₹7,200</div><div class="op-kt">Pending settlement</div></div><div class="op-kpi"><div class="op-kv">₹1,92,300</div><div class="op-kt">Earned (YTD)</div></div></div><table class="op-table"><tr><th>Booking ID</th><th>Gross value</th><th>Commission</th><th>%</th><th>Status</th></tr><tr><td>VGP-OP-10231</td><td>₹96,000</td><td>₹9,600</td><td>10%</td><td>'+opBadge("Payable","b-ok")+'</td></tr><tr><td>VGP-OP-10228</td><td>₹42,500</td><td>₹4,250</td><td>10%</td><td>'+opBadge("On hold","b-warn")+'</td></tr><tr><td>VGP-OP-10219</td><td>₹1,28,000</td><td>₹12,800</td><td>10%</td><td>'+opBadge("Paid","b-ok")+'</td></tr></table>';}
function opInvoices(){return '<h2 class="op-title">Invoices & GST</h2><table class="op-table"><tr><th>Invoice</th><th>Booking</th><th>Date</th><th>Amount</th><th></th></tr><tr><td>INV-2026-0231</td><td>VGP-OP-10231</td><td>24 Aug</td><td>₹96,000</td><td><a onclick="toast(\'🧾 Invoice PDF downloaded\')">Download</a></td></tr><tr><td>INV-2026-0219</td><td>VGP-OP-10219</td><td>02 Aug</td><td>₹1,28,000</td><td><a onclick="toast(\'🧾 Invoice PDF downloaded\')">Download</a></td></tr></table><div class="op-qa"><button class="op-qbtn" onclick="toast(\'📄 Monthly consolidated invoice downloaded\')">Monthly Consolidated Invoice</button><button class="op-qbtn" onclick="toast(\'📊 Exported\')">Export Data</button></div>';}
function opReports(){var reps=['Daily bookings','Monthly bookings','Park-wise bookings','Ticket-category report','Guest footfall','Payment report','Wallet statement','Commission report','Cancellation report','Refund report'];return '<h2 class="op-title">Reports</h2><p class="op-muted">Export in Excel, CSV or PDF.</p><div class="op-qa">'+reps.map(function(r){return '<button class="op-qbtn" onclick="toast(\'📈 '+r+' exported\')">'+r+'</button>';}).join('')+'</div>';}
function opProfile(){var name=esc(opAgencyName());return '<h2 class="op-title">Agency Profile</h2><div class="op-two"><div class="op-panel"><h3 class="op-h">Agency</h3><p><b>'+name+'</b><br>Type: Tour Operator<br>GST: 33ABCDE1234F1Z5<br>PAN: ABCDE1234F</p></div><div class="op-panel"><h3 class="op-h">Bank (masked)</h3><p>Account: XXXXXXXX4582<br>IFSC: ICIC0002778<br>Aadhaar: XXXX XXXX 2290</p></div></div><div class="op-note">Sensitive changes (bank / GST) require OTP verification and admin approval, and are audit-logged. Account status: <b class="op-green">Approved</b>.</div><div class="op-qa"><button class="op-qbtn" onclick="toast(\'🔐 OTP sent for verification\')">Edit Bank Details</button><button class="op-qbtn" onclick="toast(\'👤 User management\')">Manage Users</button></div>';}
function opSupport(){return '<h2 class="op-title">Partner Support</h2><div class="op-form"><div class="two-col"><div class="field"><label>Issue category</label><select><option>Booking support</option><option>Payment support</option><option>Refund support</option><option>Rate enquiry</option><option>Technical issue</option><option>Group arrival support</option></select></div><div class="field"><label>Booking ID (optional)</label><input placeholder="VGP-OP-…"></div></div><div class="field"><label>Subject</label><input placeholder="Brief subject"></div><div class="field"><label>Description</label><textarea rows="3" placeholder="Describe your issue"></textarea></div><button class="btn-next cta-green" onclick="toast(\'🎫 Support ticket raised — we will respond shortly\')">Raise Ticket</button></div>';}
function doLogin(){
 var u=document.getElementById('login-user').value.trim();
 var pw=document.getElementById('login-pass').value;
 var isOp=document.getElementById('tab-operator').classList.contains('active');
 if(!u){toast('⚠️ Enter your email or mobile');return;}
 if(pw.length<4){toast('🔒 Password must be at least 4 characters');return;}
 if(isOp){var code=document.getElementById('login-op').value.trim();if(!/^UKD-OP-\d{4}$/i.test(code)){toast('🧳 Enter a valid operator code (e.g. UKD-OP-1234)');return;}}
 try{localStorage.setItem('ukdUser',JSON.stringify({user:u,operator:isOp,ts:Date.now()}));}catch(_){}
 closeModal('login-modal');
 toast('🔑 Welcome, '+u+'!');
 reflectLogin();
 if(isOp){openOpPortal();}
}
function reflectLogin(){
 var u=null;try{u=JSON.parse(localStorage.getItem('ukdUser')||'null');}catch(_){}
 document.querySelectorAll('.btn-login').forEach(function(b){
  if(u){b.textContent='👤 '+u.user.split('@')[0].slice(0,12);b.onclick=logout;}
  else{b.textContent='Login';b.onclick=function(){openLogin('guest');};}
 });
}
function logout(){try{localStorage.removeItem('ukdUser');}catch(_){}reflectLogin();toast('👋 Logged out');}
document.addEventListener('DOMContentLoaded',reflectLogin);
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.scroll-banner').forEach(function(b,i){b.classList.add('sb-c'+(i%5));});});
document.addEventListener('DOMContentLoaded',function(){var p=['orn-swirl','orn-zig','orn-cross'],i=0;document.querySelectorAll('.section-head').forEach(function(sh){var d=document.createElement('div');d.className='ornament '+p[i%3];i++;sh.parentNode.insertBefore(d,sh.nextSibling);});});
renderOffers();renderCal();

/* ---------------- popups ---------------- */
function ticketPopup(t){
 document.getElementById('tp-title').textContent='🎟️ '+t+' Pass';
 document.getElementById('tp-body').innerHTML={
  Adult:'Theme Park & Beach Access.<br>✅ All regular rides & water park.<br>💰 <s>₹975</s> → <b>₹828.75</b> online price.',
  Child:'For kids 90–130 cm tall.<br>✅ Theme Park & Beach Access.<br>🎁 FREE below 90 cm — and free below 130 cm with the Little Legends offer!<br>💰 <s>₹763</s> → <b>₹648.55</b>.',
  Senior:'Age 60+ with valid ID.<br>✅ Theme Park & Beach Access.<br>💰 <s>₹763</s> → <b>₹648.55</b>.',
  Student:'Current-year college ID mandatory at entry.<br>✅ Theme Park & Beach Access.<br>💰 ₹780 — or 20% off with the Student Pass offer!',
  Double:'One ticket, two kingdoms!<br>✅ VGP Universal Kingdom + VGP Marine Kingdom.<br>💰 Adult <s>₹1,715</s> ₹1,313 · Child <s>₹1,403</s> ₹1,128 (before tax).'}[t];
 document.getElementById('ticket-modal').classList.add('show');
}
function _v(id){var el=document.getElementById(id);return el&&el.value?el.value.trim():'';}
function openOptReg(){go('optreg');document.getElementById('optreg-msg').innerHTML='';document.getElementById('optreg-form').style.display='';optStep(1);}
function optStep(n){
 if(n>=2){var em=_v('o-email'),mo=_v('o-mobile'),pw=_v('o-pass'),pw2=_v('o-pass2');
  if(!_v('o-name')){toast('Enter your full name');return;}
  if(!validEmail(em)){toast('Enter a valid email address');return;}
  if(!validPhone(mo)){toast('Enter a valid mobile number');return;}
  if(pw.length<6){toast('Password must be at least 6 characters');return;}
  if(pw!==pw2){toast('Passwords do not match');return;}}
 if(n>=3){if(!_v('a-name')){toast('Enter the agency name');return;}
  if(!_v('a-pin')){toast('Enter the PIN code');return;}
  if(!_v('a-state')){toast('Select a state');return;}
  if(!_v('a-city')){toast('Enter the city');return;}
  if(!_v('a-pan')){toast('Enter the PAN number');return;}}
 for(var i=1;i<=3;i++){document.getElementById('rstep'+i).style.display=(i===n)?'':'none';var s=document.getElementById('rst'+i);s.className='reg-step'+(i<n?' done':i===n?' now':'');}
 document.getElementById('page-optreg').scrollIntoView({behavior:'smooth'});
}
function optSubmit(){
 var chq=document.getElementById('b-cheque');
 if(chq&&chq.files&&chq.files.length){var t=chq.files[0].type;if(!/^image\/(jpeg|png|jpg)$/.test(t)){toast('The cancelled cheque must be a JPG or PNG image.');return;}}
 if(!_v('b-bank')||!_v('b-acc')||!_v('b-ifsc')){toast('Enter your bank details');return;}
 if(!document.getElementById('b-agree').checked){toast('Please agree to the privacy policy & terms');return;}
 var reg={name:_v('o-name'),email:_v('o-email'),mobile:_v('o-mobile'),designation:_v('o-desig'),agency:_v('a-name'),address:_v('a-addr'),pin:_v('a-pin'),state:_v('a-state'),district:_v('a-district'),city:_v('a-city'),pan:_v('a-pan'),gst:_v('a-gst'),idType:_v('a-idtype'),bank:_v('b-bank'),account:_v('b-acc'),beneficiary:_v('b-benef'),ifsc:_v('b-ifsc'),status:'under_review',ts:new Date().toISOString()};
 try{var arr=JSON.parse(localStorage.getItem('ukdOperators')||'[]');arr.push(reg);localStorage.setItem('ukdOperators',JSON.stringify(arr));}catch(_){}
 try{fetch(API_BASE+'/api/operators',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(reg)}).then(function(){}).catch(function(){});}catch(_){}
 document.getElementById('optreg-form').style.display='none';
 document.getElementById('optreg-msg').innerHTML='<div class="reg-review">Your account is under review process. You will receive an email notification after the completing the procedure.</div>';
 document.getElementById('page-optreg').scrollIntoView({behavior:'smooth'});
 toast('🎉 Registration submitted for review');
}
function openLogin(t){document.getElementById('login-modal').classList.add('show');loginTab(t);}
function loginTab(t){
 document.getElementById('tab-guest').classList.toggle('active',t==='guest');
 document.getElementById('tab-operator').classList.toggle('active',t==='operator');
 document.getElementById('op-code').style.display=t==='operator'?'':'none';
 document.getElementById('login-title').textContent=t==='operator'?"🧳 Tour Operator's Login":'🔑 Login';
}
function closeModal(id){document.getElementById(id).classList.remove('show');}
/* ---------------- intro video ---------------- */
const YT_ID='a1Fw7SqAcP0';
const INTRO_SRC='https://www.youtube.com/embed/'+YT_ID+'?autoplay=1&mute=1&playsinline=1&rel=0&loop=1&playlist='+YT_ID;
function introIframe(){document.getElementById('intro-media').innerHTML=
 `<iframe src="${INTRO_SRC}" title="VGP Universal Kingdom — official video" frameborder="0" allow="autoplay; encrypted-media; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>`;}
function introSplash(){document.getElementById('intro-media').innerHTML=
 `<div class="intro-splash" style="background-image:url('https://img.youtube.com/vi/${YT_ID}/maxresdefault.jpg')">
   <a class="intro-play" href="https://www.youtube.com/watch?v=${YT_ID}" target="_blank" rel="noopener"><span class="play-btn"></span>▶ Watch the official video</a>
   <p class="intro-hint">In-page playback starts automatically once the site is hosted online.<br>Tip: save the video as <b>intro.mp4</b> next to this file to play it right here.</p>
  </div>`;}
function openIntro(){
 document.getElementById('intro').classList.add('show');
 const m=document.getElementById('intro-media');
 m.innerHTML='<video src="intro.mp4" autoplay muted loop playsinline></video>';
 const v=m.querySelector('video');
 v.onerror=()=>{ if(location.protocol==='file:') introSplash(); else introIframe(); };
 if(v.error) v.onerror();
}
function closeIntro(){document.getElementById('intro').classList.remove('show');document.getElementById('intro-media').innerHTML='';}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeIntro();});
(function heroMedia(){
 const hv=document.getElementById('hero-video'); if(!hv) return;
 const v=document.createElement('video');
 v.src='intro.mp4'; v.autoplay=true; v.muted=true; v.loop=true; v.playsInline=true;
 v.onerror=()=>{ if(v.parentNode) hv.removeChild(v); };  /* no YouTube fallback — keep clean decorative hero */
 hv.appendChild(v);
})();
function setCookie(n,v,days){var d=new Date();d.setTime(d.getTime()+days*864e5);document.cookie=n+'='+encodeURIComponent(v)+';expires='+d.toUTCString()+';path=/;SameSite=Lax';}
function getCookie(n){var m=document.cookie.match('(?:^|; )'+n.replace(/([.*+?^${}()|[\]\\])/g,'\\$1')+'=([^;]*)');return m?decodeURIComponent(m[1]):null;}
function detectDevice(){
 var ua=navigator.userAgent||'',uad=navigator.userAgentData,brand='Unknown',os='Unknown',type='Desktop',model='';
 if(/iPhone/.test(ua)){brand='Apple';os='iOS';type='Mobile';model='iPhone';}
 else if(/iPad/.test(ua)){brand='Apple';os='iPadOS';type='Tablet';model='iPad';}
 else if(/Macintosh|Mac OS X/.test(ua)){brand='Apple';os='macOS';model='Mac';}
 else if(/Android/.test(ua)){os='Android';type=/Mobile/.test(ua)?'Mobile':'Tablet';var mm=ua.match(/;\s*([^;\/]+)\s+Build/);model=mm?mm[1].trim():'';
  if(/SM-|Samsung/i.test(ua))brand='Samsung';else if(/Redmi|POCO|Xiaomi|\bMi\b/i.test(ua))brand='Xiaomi';else if(/OnePlus/i.test(ua))brand='OnePlus';else if(/Vivo/i.test(ua))brand='Vivo';else if(/OPPO|CPH/i.test(ua))brand='OPPO';else if(/Realme|RMX/i.test(ua))brand='Realme';else if(/Moto/i.test(ua))brand='Motorola';else if(/Pixel/i.test(ua)){brand='Google';model=model||'Pixel';}else if(/Nokia/i.test(ua))brand='Nokia';else brand='Android';}
 else if(/Windows/.test(ua)){brand='Windows PC';os='Windows';}
 else if(/Linux/.test(ua)){brand='Linux';os='Linux';}
 var browser=/Edg\//.test(ua)?'Edge':/OPR\//.test(ua)?'Opera':/Chrome\//.test(ua)?'Chrome':/Firefox\//.test(ua)?'Firefox':/Safari\//.test(ua)?'Safari':'Browser';
 var info={brand:brand,model:model,os:os,type:type,browser:browser,ua:ua};
 info.label=(model?(brand+' '+model):brand)+' · '+os+' · '+browser;
 if(uad&&uad.getHighEntropyValues){uad.getHighEntropyValues(['model','platform']).then(function(hh){if(hh){if(hh.model)info.model=hh.model;if(hh.platform)info.os=hh.platform;info.label=(info.model?(info.brand+' '+info.model):info.brand)+' · '+info.os+' · '+info.browser;try{localStorage.setItem('vgpDevice',JSON.stringify(info));}catch(_){}}}).catch(function(){});}
 return info;
}
function currentDevice(){try{var d=JSON.parse(localStorage.getItem('vgpDevice')||'null');if(d&&d.label)return d;}catch(_){}var dd=detectDevice();try{localStorage.setItem('vgpDevice',JSON.stringify(dd));}catch(_){}return dd;}
function vgpPixel(ev,data){try{window.dataLayer=window.dataLayer||[];window.dataLayer.push(Object.assign({event:'vgp_'+ev,vid:getCookie('vgp_vid')},data||{}));}catch(_){}if(typeof fbq==='function'){try{fbq('trackCustom','VGP_'+ev,data||{});}catch(_){}}}
function maskIp(ip){if(!ip)return'';if(ip.indexOf('.')>0){var p=ip.split('.');if(p.length===4){p[3]='xxx';return p.join('.');}}if(ip.indexOf(':')>0){return ip.split(':').slice(0,3).join(':')+':xxxx';}return ip;}
function normGeo(d){if(!d)return null;if(d.success===false||d.error)return null;var country=d.country||d.country_name||'';var cc=d.country_code||d.countryCode||'';var org=(d.connection&&d.connection.isp)||d.org||d.organization_name||d.isp||'';var geo={ip:maskIp(d.ip),city:d.city||'',region:d.region||d.region_name||d.state||'',country:country,countryCode:cc,org:org,lat:d.latitude||d.lat,lon:d.longitude||d.lon,ts:Date.now()};geo.label=[geo.city,geo.region,geo.country].filter(Boolean).join(', ');return geo.country?geo:null;}
function currentGeo(){try{return JSON.parse(localStorage.getItem('vgpGeo')||'null')||{};}catch(_){return {};}}
function captureLocation(){
 try{var g=JSON.parse(localStorage.getItem('vgpGeo')||'null');if(g&&g.ts&&(Date.now()-g.ts<864e5)&&g.country)return;}catch(_){}
 var urls=['https://ipwho.is/','https://ipapi.co/json/','https://get.geojs.io/v1/ip/geo.json'];
 (function next(i){if(i>=urls.length)return;fetch(urls[i]).then(function(r){return r.json();}).then(function(d){var geo=normGeo(d);if(geo){try{localStorage.setItem('vgpGeo',JSON.stringify(geo));}catch(_){}try{var rt=JSON.parse(localStorage.getItem('vgpRetarget')||'{}');rt.location=geo.label;rt.country=geo.country;localStorage.setItem('vgpRetarget',JSON.stringify(rt));}catch(_){}vgpPixel('Location',{country:geo.country,city:geo.city});}else{next(i+1);}}).catch(function(){next(i+1);});})(0);
}
function requestPreciseLocation(){if(!navigator.geolocation){toast('Precise location not supported');return;}navigator.geolocation.getCurrentPosition(function(pos){var g=currentGeo();g.preciseLat=pos.coords.latitude;g.preciseLon=pos.coords.longitude;g.precise=true;try{localStorage.setItem('vgpGeo',JSON.stringify(g));}catch(_){}toast('📍 Precise location shared — thanks!');vgpPixel('PreciseLocation',{});},function(){toast('Location permission declined');});}
function initRetargeting(){
 var vid=getCookie('vgp_vid');if(!vid){vid='v-'+Date.now().toString(36)+Math.random().toString(36).slice(2,8);setCookie('vgp_vid',vid,365);}
 var dev=currentDevice();var params=new URLSearchParams(location.search);var rt=null;
 try{rt=JSON.parse(localStorage.getItem('vgpRetarget')||'null');}catch(_){}
 if(!rt){rt={vid:vid,firstVisit:new Date().toISOString(),visits:0,referrer:document.referrer||'direct',utm:{source:params.get('utm_source')||'',medium:params.get('utm_medium')||'',campaign:params.get('utm_campaign')||''}};}
 rt.vid=vid;rt.lastVisit=new Date().toISOString();rt.visits=(rt.visits||0)+1;rt.device=dev.label;rt.deviceBrand=dev.brand;
 try{localStorage.setItem('vgpRetarget',JSON.stringify(rt));}catch(_){}
 setCookie('vgp_rt',dev.brand+'|'+dev.type+'|'+rt.visits,365);
 vgpPixel('PageView',{device:dev.brand,type:dev.type});
 captureLocation();
 if(!getCookie('vgp_cc'))showCookieBanner();
}
function showCookieBanner(){if(document.getElementById('cookie-banner'))return;var d=document.createElement('div');d.id='cookie-banner';d.className='cookie-banner';d.innerHTML='🍪 We use cookies to improve your experience and for advertising & retargeting. By continuing you agree to our cookie policy. <button onclick="acceptCookies()">Accept</button>';document.body.appendChild(d);}
function acceptCookies(){setCookie('vgp_cc','1',365);var b=document.getElementById('cookie-banner');if(b)b.remove();vgpPixel('CookieConsent',{});}
function showTerms(e){if(e&&e.preventDefault)e.preventDefault();document.getElementById('tp-title').textContent='📜 VGP Universal Kingdom — Terms & Conditions';document.getElementById('tp-body').innerHTML='<p style="font-weight:700">Key points — the full document governs your booking.</p><b>1. Acceptance:</b> By booking, using a ticket or entering the Park you accept these Terms, the Privacy Policy and the refund policy.<br><br><b>2. Eligibility &amp; admission:</b> The person booking must be 18+ and is responsible for all guests. A ticket grants entry only to the areas/attractions in the selected category; some facilities (food, lockers, parking, special attractions) cost extra.<br><br><b>3. Ticket categories:</b> Children below 90 cm enter free; child ticket 90–130 cm; senior 60+ with valid age ID; student needs a current college ID. Height/eligibility may be verified at the gate — the price difference is payable, or entry may be denied.<br><br><b>4. Offers:</b> Only one promotional offer or coupon per booking; the best eligible offer may be applied automatically and is verified at the entrance. A convenience fee applies per booking and is not discounted.<br><br><b>5. Cancellation &amp; refunds:</b> Confirmed bookings are non-cancellable, non-refundable and non-transferable; no refund for no-show or late arrival. Where VGP approves a refund it is made to the original payment method and may take 15–30 days.<br><br><b>6. Tickets:</b> E-tickets/QR are unique, single-use and must not be resold or duplicated. Valid ID/proof must be carried for offer tickets.<br><br><b>7. Photography, media &amp; CCTV:</b> CCTV operates across the premises; guests may photograph only in permitted areas and may appear in Park media. Commercial/professional shoots need prior written permission.<br><br><b>8. Data &amp; privacy:</b> Personal, device and usage data is handled per the Privacy Policy; cookies are used for analytics and advertising.<br><br><b>9. Safety &amp; liability:</b> Rides and water/beach activities carry inherent risks; guests must follow all safety instructions.<br><br><a href="assets/terms.pdf" target="_blank" rel="noopener" style="color:var(--red);font-weight:800;text-decoration:underline">📄 Read the full Terms &amp; Conditions (PDF)</a>';document.getElementById('ticket-modal').classList.add('show');}
document.addEventListener('DOMContentLoaded',initRetargeting);
let toastT;
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2600);}
</script>
</body>
</html>
