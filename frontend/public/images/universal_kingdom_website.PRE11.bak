<!-- Login modal -->
<div class="modal" id="login-modal" role="dialog" aria-modal="true" aria-labelledby="login-title">
  <div class="modal-box">
    <button class="x" onclick="closeModal('login-modal')" aria-label="Close login">✕</button>
    <h3 id="login-title">Login</h3>
    <div class="tabs">
      <button class="tab active" id="tab-guest" onclick="loginTab('guest')">Guest</button>
      <button class="tab" id="tab-operator" onclick="loginTab('operator')">Tour Operator</button>
    </div>
    <div class="field"><label id="login-user-label" for="login-user">Email / Mobile</label><input id="login-user" autocomplete="username" placeholder="Enter email or mobile"></div>
    <div class="field"><label for="login-pass">Password</label><input id="login-pass" type="password" autocomplete="current-password" placeholder="••••••••"></div>
    <div class="field" id="op-code" style="display:none"><label for="login-op">Operator Code</label><input id="login-op" placeholder="e.g. UKD-OP-1234"></div>
    <button class="btn-next" style="width:100%" onclick="doLogin()">Login</button>
  </div>
</div>

