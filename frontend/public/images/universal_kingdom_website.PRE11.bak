</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<div class="mascot" title="Chutti Sepoy reporting for duty!" onclick="toast('👑 Kutti Raja: Welcome to my kingdom!')"><img src="assets/img_79f9c0375c2d.png" loading="lazy" decoding="async" alt="Chutti Sepoy mascot"></div>

<script>
/* ---------------- data ---------------- */
/* ---------------- ride illustrations (brand vector style) ---------------- */
const D='#3A2312',Y='#FDDB00',R='#E93212',P='#681B81',M='#C5E3DB',T='#DBB68A',BR='#B36D3C',W='#fff';
const S=`stroke="${D}" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"`;
const sv=b=>`<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">${b}</svg>`;
const pod=(x,y,f,r=8)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="${f}" ${S}/>`;
const ring=(cx,cy,rad,cols,pr=8)=>cols.map((f,i)=>{const a=i*2*Math.PI/cols.length-Math.PI/2;return pod(cx+rad*Math.cos(a),cy+rad*Math.sin(a),f,pr);}).join('');
const IC={
wheel:()=>sv(`<path d="M30,104 L90,104" fill="none" ${S}/><path d="M60,54 L44,104 M60,54 L76,104" fill="none" ${S}/><circle cx="60" cy="54" r="34" fill="none" ${S}/><path d="M60,20 L60,88 M26,54 L94,54 M36,30 L84,78 M84,30 L36,78" fill="none" stroke="${D}" stroke-width="3"/>${ring(60,54,34,[Y,R,M,Y,R,M])}<circle cx="60" cy="54" r="8" fill="${Y}" ${S}/>`),
enterprise:()=>sv(`<path d="M28,104 L98,104" fill="none" ${S}/><path d="M88,104 L54,52" fill="none" ${S}/><circle cx="52" cy="48" r="28" fill="none" ${S}/><path d="M52,24 L52,72 M28,48 L76,48 M35,31 L69,65 M69,31 L35,65" fill="none" stroke="${D}" stroke-width="3"/>${ring(52,48,28,[R,Y,M,R,Y,M],7)}<circle cx="52" cy="48" r="7" fill="${Y}" ${S}/>`),
spinner:()=>sv(`<circle cx="60" cy="62" r="47" fill="none" stroke="${D}" stroke-width="3" stroke-dasharray="10 14"/><path d="M60,62 L60,22 M60,62 L26,82 M60,62 L94,82" fill="none" ${S}/>${pod(60,20,R,10)}${pod(25,84,Y,10)}${pod(95,84,M,10)}<circle cx="60" cy="62" r="9" fill="${Y}" ${S}/>`),
teacup:()=>sv(`<ellipse cx="60" cy="98" rx="40" ry="9" fill="${P}" ${S}/><path d="M28,52 L32,74 Q36,92 60,92 Q84,92 88,74 L92,52 Z" fill="${R}" ${S}/><path d="M92,56 Q110,60 98,76" fill="none" ${S}/><path d="M46,66 q7,-7 14,0 q7,7 14,0" fill="none" stroke="${W}" stroke-width="4" stroke-linecap="round"/><path d="M28,52 L92,52" fill="none" ${S}/>`),
plane:()=>sv(`<circle cx="60" cy="60" r="50" fill="none" stroke="${D}" stroke-width="3" stroke-dasharray="10 14"/><ellipse cx="58" cy="62" rx="28" ry="13" fill="${R}" ${S}/><path d="M52,62 L30,86 L58,72 Z" fill="${Y}" ${S}/><path d="M36,56 L26,40 L46,52 Z" fill="${Y}" ${S}/><circle cx="50" cy="58" r="4" fill="${W}"/><circle cx="63" cy="58" r="4" fill="${W}"/><circle cx="87" cy="62" r="6" fill="${Y}" ${S}/><path d="M93,52 L97,72" fill="none" ${S}/>`),
octopus:()=>sv(`<path d="M40,58 Q40,30 60,30 Q80,30 80,58 Q70,64 60,64 Q50,64 40,58 Z" fill="${P}" ${S}/><path d="M46,60 C30,70 24,84 30,96" fill="none" ${S}/><path d="M74,60 C90,70 96,84 90,96" fill="none" ${S}/><path d="M55,64 C48,78 44,88 46,98" fill="none" ${S}/><path d="M65,64 C72,78 76,88 74,98" fill="none" ${S}/>${pod(28,98,Y)}${pod(92,98,M)}${pod(45,102,R)}${pod(75,102,Y)}<circle cx="53" cy="44" r="3.5" fill="${W}"/><circle cx="67" cy="44" r="3.5" fill="${W}"/>`),
ship:()=>sv(`<path d="M14,34 Q60,6 106,34" fill="none" stroke="${D}" stroke-width="3" stroke-dasharray="9 12"/><path d="M60,36 L60,66" fill="none" ${S}/><path d="M60,36 L82,42 L60,50 Z" fill="${R}" ${S}/><path d="M22,66 Q60,84 98,66 L88,88 Q60,100 32,88 Z" fill="${BR}" ${S}/><path d="M30,74 Q60,88 90,74" fill="none" stroke="${D}" stroke-width="3"/>`),
swinger:()=>sv(`<path d="M24,40 Q60,10 96,40 L96,48 Q60,22 24,48 Z" fill="${R}" ${S}/><path d="M60,16 L60,28" fill="none" ${S}/><path d="M34,46 L22,78 M60,30 L60,66 M86,46 L98,78" fill="none" stroke="${D}" stroke-width="3"/><rect x="14" y="78" width="16" height="12" rx="4" fill="${Y}" ${S}/><rect x="52" y="66" width="16" height="12" rx="4" fill="${M}" ${S}/><rect x="90" y="78" width="16" height="12" rx="4" fill="${W}" ${S}/>`),
carousel:()=>sv(`<path d="M20,46 Q60,12 100,46 L20,46 Z" fill="${R}" ${S}/><path d="M20,46 q10,8 20,0 q10,8 20,0 q10,8 20,0 q10,8 20,0" fill="none" stroke="${D}" stroke-width="3"/><path d="M60,14 L60,58" fill="none" ${S}/><ellipse cx="60" cy="98" rx="42" ry="9" fill="${P}" ${S}/><path d="M36,52 L36,92 M84,52 L84,92" fill="none" stroke="${D}" stroke-width="3"/><ellipse cx="60" cy="74" rx="14" ry="8" fill="${T}" ${S}/><path d="M72,70 q9,-9 4,-16" fill="none" ${S}/><path d="M52,80 L50,92 M68,80 L70,92" fill="none" stroke="${D}" stroke-width="3"/>`),
balloon:()=>sv(`<path d="M60,12 C40,12 32,32 34,48 C36,64 48,74 60,74 C72,74 84,64 86,48 C88,32 80,12 60,12 Z" fill="${R}" ${S}/><path d="M48,15 C42,28 42,58 50,72 M72,15 C78,28 78,58 70,72" fill="none" stroke="${D}" stroke-width="3"/><path d="M46,72 L52,88 M74,72 L68,88" fill="none" stroke="${D}" stroke-width="3"/><rect x="48" y="88" width="24" height="16" rx="4" fill="${T}" ${S}/>`),
kangaroo:()=>sv(`<path d="M30,94 Q16,92 14,76" fill="none" stroke="${D}" stroke-width="8" stroke-linecap="round"/><ellipse cx="52" cy="70" rx="20" ry="24" fill="${BR}" ${S}/><ellipse cx="52" cy="76" rx="10" ry="13" fill="${T}" stroke="none"/><circle cx="74" cy="38" r="11" fill="${BR}" ${S}/><path d="M69,29 L64,14 L76,26 Z" fill="${BR}" ${S}/><path d="M80,28 L84,14 L88,28 Z" fill="${BR}" ${S}/><circle cx="78" cy="38" r="2.5" fill="${D}"/><path d="M40,92 L64,92 Q72,92 70,84" fill="none" ${S}/><path d="M22,108 q10,5 20,0 M52,108 q10,5 20,0" fill="none" stroke="${D}" stroke-width="3"/>`),
clown:()=>sv(`<circle cx="42" cy="52" r="12" fill="${M}" ${S}/><circle cx="78" cy="52" r="12" fill="${M}" ${S}/><circle cx="60" cy="52" r="23" fill="${W}" ${S}/><path d="M46,32 L60,8 L74,32 Z" fill="${P}" ${S}/><circle cx="60" cy="10" r="5" fill="${Y}" ${S}/><circle cx="60" cy="55" r="6" fill="${R}" ${S}/><circle cx="52" cy="46" r="3" fill="${D}"/><circle cx="68" cy="46" r="3" fill="${D}"/><path d="M50,62 Q60,70 70,62" fill="none" ${S}/><path d="M42,78 q9,12 18,0 q9,12 18,0 L74,94 Q60,102 46,94 Z" fill="${Y}" ${S}/>`),
car:()=>sv(`<ellipse cx="60" cy="88" rx="38" ry="12" fill="${P}" ${S}/><path d="M30,84 Q28,64 46,60 L74,60 Q92,64 90,84 Z" fill="${R}" ${S}/><path d="M74,60 Q70,44 84,40" fill="none" ${S}/><circle cx="86" cy="38" r="5" fill="${Y}" ${S}/><path d="M42,74 Q54,64 66,74" fill="none" stroke="${W}" stroke-width="4" stroke-linecap="round"/><circle cx="44" cy="67" r="3" fill="${W}"/>`),
coaster:()=>sv(`<path d="M14,92 Q34,34 52,66 Q66,92 84,56 Q94,38 106,44" fill="none" stroke="${D}" stroke-width="5"/><path d="M30,66 L30,100 M52,70 L52,100 M84,60 L84,100" fill="none" stroke="${D}" stroke-width="3"/><path d="M14,100 L106,100" fill="none" ${S}/><g transform="rotate(-38 36 52)"><rect x="22" y="44" width="28" height="15" rx="5" fill="${Y}" ${S}/></g><circle cx="27" cy="63" r="4" fill="${D}"/><circle cx="42" cy="51" r="4" fill="${D}"/>`),
disco:()=>sv(`<path d="M18,84 Q60,108 102,84" fill="none" stroke="${D}" stroke-width="6" stroke-linecap="round"/><ellipse cx="60" cy="54" rx="32" ry="13" fill="${P}" ${S}/><circle cx="60" cy="54" r="7" fill="${Y}" ${S}/>${pod(30,52,Y,6)}${pod(90,52,M,6)}${pod(45,64,R,6)}${pod(75,64,Y,6)}${pod(45,44,M,6)}${pod(75,44,R,6)}<path d="M28,72 L24,82 M92,72 L96,82" fill="none" stroke="${D}" stroke-width="3"/>`),
pendulum:()=>sv(`<path d="M34,102 L60,28 L86,102" fill="none" ${S}/><path d="M60,28 L60,68" fill="none" ${S}/><circle cx="60" cy="82" r="16" fill="${R}" ${S}/>${ring(60,82,16,[Y,W,Y,W,Y],5)}<circle cx="60" cy="82" r="5" fill="${Y}" ${S}/><path d="M22,42 Q15,58 24,74" fill="none" stroke="${D}" stroke-width="3" stroke-dasharray="7 9"/>`),
eiffel:()=>sv(`<path d="M60,16 C56,42 46,72 28,100 L44,100 Q60,82 76,100 L92,100 C74,72 64,42 60,16 Z" fill="${BR}" ${S}/><path d="M44,66 L76,66 M50,42 L70,42" fill="none" stroke="${D}" stroke-width="3"/><path d="M60,16 L60,6" fill="none" ${S}/><path d="M60,6 L74,10 L60,16 Z" fill="${R}" ${S}/>`),
boat:()=>sv(`<rect x="46" y="50" width="28" height="18" rx="5" fill="${M}" ${S}/><path d="M28,68 Q60,80 92,68 L84,86 Q60,94 36,86 Z" fill="${Y}" ${S}/><circle cx="55" cy="59" r="3" fill="${D}"/><circle cx="66" cy="59" r="3" fill="${D}"/><path d="M18,96 q10,6 20,0 q10,6 20,0 q10,6 20,0 q10,6 20,0" fill="none" stroke="${D}" stroke-width="3"/>`),
carpet:()=>sv(`<path d="M24,66 Q42,50 60,66 Q78,82 96,66 L96,80 Q78,96 60,80 Q42,64 24,80 Z" fill="${P}" ${S}/><path d="M28,70 Q42,58 58,69 M62,75 Q78,88 92,72" fill="none" stroke="${Y}" stroke-width="3"/>${pod(24,66,Y,4)}${pod(96,66,Y,4)}${pod(24,80,Y,4)}${pod(96,80,Y,4)}<path d="M44,32 l3,8 8,3 -8,3 -3,8 -3,-8 -8,-3 8,-3 Z" fill="${Y}" ${S}/><path d="M80,22 l2,5 5,2 -5,2 -2,5 -2,-5 -5,-2 5,-2 Z" fill="${W}" ${S}/>`),
tower:()=>sv(`<rect x="52" y="18" width="16" height="76" fill="${T}" ${S}/><path d="M52,30 L68,42 M68,30 L52,42 M52,54 L68,66 M68,54 L52,66 M52,78 L68,90" fill="none" stroke="${D}" stroke-width="2.5"/><path d="M48,18 L60,6 L72,18 Z" fill="${R}" ${S}/><rect x="34" y="52" width="52" height="17" rx="6" fill="${R}" ${S}/><circle cx="45" cy="61" r="4" fill="${W}"/><circle cx="60" cy="61" r="4" fill="${W}"/><circle cx="75" cy="61" r="4" fill="${W}"/><path d="M28,36 L28,48 M28,88 L28,76" fill="none" stroke="${D}" stroke-width="3" stroke-dasharray="5 7"/><path d="M24,100 L96,100" fill="none" ${S}/>`)
};
const rides=[
/* ---- FAMILY (5) ---- */
{n:"Tea Cup",m:"Okamoto · Japan",c:"family",i:"teacup",bg:"bg-blue",d:"Climb into a colourful teacup and spin your way through a cheerful adventure. Gentle thrills, playful turns and plenty of laughter."},
{n:"Telecombat",m:"Okamoto · Japan",c:"family",ph:"Sky War on Telecombat",bg:"bg-purple",d:"Take control of your own flying vehicle as you rise, dip and circle through the air. Every rider gets a playful aerial adventure."},
{n:"Merry-Go-Round",m:"Okamoto · Japan",c:"family",i:"carousel",bg:"bg-blue",d:"Ride beautifully crafted horses to gentle movement and cheerful music. A timeless, magical classic for children and families."},
{n:"Balloon Racer",m:"Okamoto · Japan",c:"family",ph:"Balloon Racer",bg:"bg-green",d:"Climb into a colourful balloon-shaped gondola and gently rise into the air. Smooth circles and delightful views for the family."},
{n:"Crazy Plane",m:"Zamperla · Italy",c:"family",i:"plane",bg:"bg-blue",d:"Take flight as the Crazy Plane spins, rises and moves through the air. Gentle thrills with the exciting sensation of flying."},
/* ---- ADULT (13) ---- */
{n:"Flying Machine",m:"Zamperla · Italy",c:"adult",ph:"Flying Machine",bg:"bg-yellow",d:"Take to the skies as the Flying Machine rises and circles through the air. The exciting feeling of true flight."},
{n:"Power Surge",m:"Zamperla · Italy",c:"adult",ph:"Top Gun",bg:"bg-purple",d:"Brace yourself for powerful spins, sweeping swings and unexpected changes in direction. An electrifying mix of speed, height and adrenaline."},
{n:"Rock & Roll",m:"Okamoto · Japan",c:"adult",i:"spinner",bg:"bg-green",d:"Get ready to spin, twist and rock through an energetic adventure. Fast rotations and lively movements deliver non-stop excitement."},
{n:"Giant Wheel",m:"UKD Classic",c:"adult",ph:"Ferris Wheel",bg:"bg-purple",d:"Rise high above the park and enjoy beautiful panoramic views from the top. See the whole Kingdom — and the sea — from the very top."},
{n:"Octopus",m:"Okamoto · Japan",c:"adult",i:"octopus",bg:"bg-yellow",d:"Hold on as the giant arms spin, rise and dip in different directions. Speed and unpredictable movement make it thrillingly lively."},
{n:"Flash Dance",m:"Okamoto · Japan",c:"adult",i:"spinner",bg:"bg-yellow",d:"Feel the rush as the ride spins rapidly and changes direction without warning. A dazzling adventure of speed and surprise."},
{n:"Disco’16",m:"Zamperla · Italy",c:"adult",i:"disco",bg:"bg-yellow",d:"Ride a giant spinning disc that sweeps back and forth along a curved track. Rotation, speed and soaring movement in one unforgettable thrill."},
{n:"Jumping Tower",m:"Moser Rides",c:"adult",i:"tower",bg:"bg-blue",d:"Rise high above the ground before bouncing through exciting drops. Weightless moments, laughter and adventure combined."},
{n:"Viking",m:"Okamoto · Japan",c:"adult",i:"ship",bg:"bg-blue",d:"Set sail aboard a giant ship that swings higher with every movement. Exciting drops and moments of pure weightlessness."},
{n:"Flying Tiger",m:"UKD Classic",c:"adult",i:"pendulum",bg:"bg-red",d:"Leap on the tiger's back as it swoops and circles high above the midway. A roaring adventure of speed and sweeping turns."},
{n:"Wave Swinger",m:"Okamoto · Japan",c:"adult",i:"swinger",bg:"bg-purple",d:"Soar through the air as colourful chairs rise, tilt and circle gracefully. A refreshing feeling of freedom, speed and excitement."},
{n:"Mixer",m:"Zamperla · Italy",c:"adult",i:"spinner",bg:"bg-purple",d:"Prepare for powerful spins and sweeping rotations on this high-energy attraction. Intense, pulse-racing fun for adventure lovers."},
{n:"Roller Coaster",m:"UKD Classic",c:"adult",ph:"Roller Coaster",bg:"bg-red",d:"Race through exciting twists, sharp turns and thrilling drops at high speed. A heart-pounding adventure riders will remember."},
/* ---- CHILD (4) ---- */
{n:"Fun Clown",m:"UKD Classic",c:"child",i:"clown",bg:"bg-green",d:"Join the cheerful Fun Clown for a colourful ride filled with smiles. Gentle movement makes it perfect for young children."},
{n:"Flying Chair",m:"Omes",c:"child",i:"swinger",bg:"bg-red",d:"Colourful chairs gently spin little adventurers through the air. Smooth movement for a safe, joyful feeling of flight."},
{n:"Aladdin",m:"Omes",c:"child",i:"carpet",bg:"bg-yellow",d:"Embark on a magical journey aboard a colourful flying carpet. Gentle spins make an enchanting family adventure."},
{n:"Jet Star",m:"Okamoto · Japan",c:"child",i:"coaster",bg:"bg-purple",d:"Hold on tight as the mini coaster races through drops and sweeping curves. The perfect first taste of coaster thrills."},
/* ---- WATER PARK (11) ---- */
{n:"Surfing Pool",m:"Aqua Kingdom",c:"water",e:"🏄",bg:"bg-blue",d:"Catch the Kingdom's rolling surf right beside the Bay of Bengal. Body-surf the swells and ride wave after wave."},
{n:"Wave Pool",m:"Aqua Kingdom",c:"water",e:"🌊",bg:"bg-purple",d:"Dive into rolling waves in the Kingdom's giant wave pool. Thousands of gallons of swirling, splashing fun for everyone."},
{n:"Tornado",m:"Aqua Kingdom",c:"water",e:"🌪️",bg:"bg-green",d:"Spiral down the giant funnel and whirl like you're inside a storm. The splashdown is worth every scream."},
{n:"Deep Sea",m:"Aqua Kingdom",c:"water",e:"🤿",bg:"bg-blue",d:"Take a plunge into the deepest pool in the park. Cool off, float about and dive like a pro."},
{n:"River Ride",m:"Aqua Kingdom",c:"water",e:"🛟",bg:"bg-yellow",d:"Grab a float and drift along the winding river. The current does the walking while you do the laughing."},
{n:"Kurinji Falls",m:"Aqua Kingdom",c:"water",e:"🏞️",bg:"bg-green",d:"Stand beneath the thundering waterfall and feel the hills come to Chennai. Nature's massage, Kingdom style."},
{n:"Multi Mat Racer",m:"Aqua Kingdom",c:"water",e:"🛝",bg:"bg-red",d:"Grab a mat, pick a lane and race your friends head-first to the splash finish. May the fastest slider win!"},
{n:"Multi Double Slide",m:"Aqua Kingdom",c:"water",e:"🛝",bg:"bg-purple",d:"Twin twisting slides running side by side — double the lanes, double the fun. Perfect for a friendly face-off."},
{n:"Multi Body Slide (Open & Closed)",m:"Aqua Kingdom",c:"water",e:"💦",bg:"bg-blue",d:"Choose the open chute for the views or the closed tube for the thrill of the dark. Either way, you land with a mighty splash."},
{n:"Kids' Water Slide",m:"Aqua Kingdom",c:"water",e:"🧒",bg:"bg-yellow",d:"Gentle mini slides made just for the little splashers. Safe, shallow and seriously fun."},
{n:"Rain Dance",m:"Aqua Kingdom",c:"water",ph:"Rain Dance",bg:"bg-purple",d:"We play thumping music and we know kids dance when they see water. You'll never find a kid sing rain-rain-go-away here!"},
/* ---- PETTING ZOO (8) ---- */
{n:"Pigeon",m:"Pet Zoo",c:"zoo",e:"🕊️",bg:"bg-blue",d:"Watch fluffy fantails and homing pigeons strut and coo. Gentle enough for the smallest visitors to greet."},
{n:"Emu",m:"Pet Zoo",c:"zoo",e:"🦤",bg:"bg-green",d:"Meet the giant flightless wonder from Australia. Watch it stride, stare and steal the show."},
{n:"Country Chicken",m:"Pet Zoo",c:"zoo",e:"🐓",bg:"bg-yellow",d:"Say hello to proud roosters and clucking hens of the good old country breed. Farm life, up close."},
{n:"Ducks",m:"Pet Zoo",c:"zoo",e:"🦆",bg:"bg-blue",d:"Follow the waddling parade around the pond. Splashy landings guaranteed."},
{n:"Rabbits",m:"Pet Zoo",c:"zoo",e:"🐇",bg:"bg-green",d:"Soft, twitchy-nosed and endlessly adorable. The cuddliest corner of the whole Kingdom."},
{n:"Sanganoor Parrots",m:"Pet Zoo",c:"zoo",e:"🦜",bg:"bg-red",d:"Bright green chatterboxes with plenty of opinions. Listen closely — they might just say hello first."},
{n:"Cockatoos",m:"Pet Zoo",c:"zoo",e:"🐦",bg:"bg-purple",d:"Crested show-offs who love an audience. Expect head-bobs, squawks and dance moves."},
{n:"Macaws",m:"Pet Zoo",c:"zoo",e:"🦜",bg:"bg-yellow",d:"Rainbow giants of the parrot world. Big, bold, brilliant — and very photogenic."}
];
const PH={};document.querySelectorAll('.polaroid img,.shot img').forEach(i=>{if(i.alt)PH[i.alt]=i.src;});
const offers=[
 {id:"student",n:"Campus Thrill Deal",p:"20% OFF",s:"College ID",d:"Show your college ID and unlock 20% off Student Fun Passes — valid only on display of a current-year college ID at entry.",bg:"bg-green"},
 {id:"kids",n:"Little Legends Saturday",p:"KIDS FREE",s:"Saturdays · Online",d:"Big adventures for little explorers! Every Saturday — online booking only — each Adult Fun Pass unlocks FREE entry for 2 kids below 130 cm.",bg:"bg-purple"},
 {id:"independence",n:"Freedom Fun Fest",p:"₹800 + tax",s:"15 Aug only",d:"Celebrate Independence Day with unlimited thrills — Adult Fun Pass at ₹800 (before tax), valid only on 15 August.",bg:"bg-yellow"},
 {id:"birthday",n:"Birthday Buddy Treat",p:"BUY 1 GET 1",s:"Birthday ID proof",d:"Celebrate your birthday with a FREE ticket for your favourite person — buy 1 Adult Fun Pass, get 1 free. Carry valid birthday ID at entry.",bg:"bg-red"},
 {id:"midweek",n:"Triple Thrill Days",p:"BUY 2 GET 1",s:"Every Tue & Wed",d:"Every Tuesday & Wednesday — buy 2 tickets and get 1 FREE across all pass categories: Adult, Child, Senior, Student & Double Fun Pass.",bg:"bg-blue"},
 {id:"friendship",n:"Friendship Trio Treat",p:"BUY 2 GET 1",s:"2 Aug only",d:"Two besties book, the third bestie goes FREE! Buy 2 tickets and get 1 free this Friendship Day, 2 August.",bg:"bg-yellow"},
 {id:"dfpadult",n:"Double the Fun Deal",p:"₹1,313",s:"Save ₹402",d:"Double Fun Pass — Adult. Two days, double the adventures, one special price. Regular ₹1,715 → offer ₹1,313. Add the Double Fun Pass — Adult to your tickets.",bg:"bg-purple"},
 {id:"dfpchild",n:"Little Explorer Double Pass",p:"₹1,128",s:"Save ₹275",d:"Double Fun Pass — Child. Double the fun for your little adventurer. Regular ₹1,403 → offer ₹1,128. Add the Double Fun Pass — Child to your tickets.",bg:"bg-red"}
];
const prices={adult:828.75,child:648.55,senior:648.55,student:780,dfpa:1313,dfpc:1128,veg:250,nonveg:300};
const mrp={adult:975,child:763,senior:763};
const labels={adult:"Adult Fun Pass",child:"Child Fun Pass",senior:"Senior Citizen Fun Pass",student:"College Student ID Fun Pass",dfpa:"Double Fun Pass — Adult",dfpc:"Double Fun Pass — Child",veg:"Veg Meal",nonveg:"Non-veg Meal"};
let qty={adult:1,child:0,senior:0,student:0,dfpa:0,dfpc:0,veg:0,nonveg:0};
let selOffer=null, selDate='', calY, calM;
const fmt=v=>'₹'+(Math.round(v*100)/100).toLocaleString('en-IN',{maximumFractionDigits:2});

/* ---------------- navigation ---------------- */
function go(p){
 document.querySelectorAll('.page').forEach(x=>x.classList.remove('visible'));
 document.getElementById('page-'+p).classList.add('visible');
 document.querySelectorAll('.nav-link').forEach(x=>x.classList.toggle('active',x.dataset.nav===p));
 window.scrollTo({top:0,behavior:'smooth'});
 if(p==='book') renderBooking();
}
function goD(p){toggleDrawer(false);go(p);}
function toggleDrawer(o){document.getElementById('drawer').classList.toggle('open',o);document.getElementById('overlay').classList.toggle('show',o);}

/* ---------------- rides ---------------- */
function rideCard(r){
 const media=r.ph&&PH[r.ph]?`<img src="${PH[r.ph]}" alt="${r.n}" loading="lazy">`:(r.e?r.e:(IC[r.i]?IC[r.i]():'🎢'));
 return `<div class="card" data-c="${r.c}" data-n="${r.n}" onclick="toast('▶ '+this.dataset.n+' — ride video plays here')">
 <div class="card-media ${r.bg}">${media}</div>
 <div class="card-body"><span class="tag">${r.m}</span><h3>${r.n}</h3><p>${r.d}</p></div></div>`;}
const hr=document.getElementById('home-rides'); if(hr) hr.innerHTML=[8,17,1,32].map(i=>rides[i]).map(rideCard).join('');
const _k=document.querySelector('.hero-raja'), _s=document.querySelector('.hero-sepoy');
document.querySelectorAll('.procl-king,.story-king').forEach(el2=>{if(_k)el2.src=_k.src;});
document.querySelectorAll('.story-sepoy').forEach(el2=>{if(_s)el2.src=_s.src;});
document.getElementById('ride-grid').innerHTML=rides.map(rideCard).join('');
document.querySelectorAll('#ride-pills .pill').forEach(p=>p.onclick=()=>{
 document.querySelectorAll('#ride-pills .pill').forEach(x=>x.classList.remove('active'));
 p.classList.add('active');
 document.querySelectorAll('#ride-grid .card').forEach(c=>{
  c.style.display=(p.dataset.f==='all'||c.dataset.c===p.dataset.f)?'':'none';});
});

/* ---------------- offers ---------------- */
function dateOk(id,isod){
 if(isod<=todayISO()) return false;
 var dow=new Date(isod+'T12:00:00').getDay(), md=isod.slice(5);
 switch(id){
  case 'kids': return dow===6;
  case 'independence': return md==='08-15';
  case 'friendship': return md==='08-02';
  case 'midweek': return dow===2||dow===3;
  default: return true;
 }
}
function offerDatesLabel(id){
 switch(id){
  case 'kids': return 'Valid on Saturdays';
  case 'independence': return 'Valid on 15 August only';
  case 'friendship': return 'Valid on 2 August only';
  case 'midweek': return 'Valid every Tuesday & Wednesday';
  default: return 'Valid on any future date';
 }
}
function offerAcc(o){
 var open=(selOffer&&selOffer.id===o.id);
 var proceed=(open&&selDate&&dateOk(o.id,selDate));
 return '<div class="offer-acc '+o.bg+(open?' open':'')+'">'+
  '<button class="offer-acc-head" onclick="toggleOffer(\''+o.id+'\')" aria-expanded="'+open+'">'+
   '<span class="oa-badge">'+o.s+'</span>'+
   '<span class="oa-name">'+o.n+'</span>'+
   '<span class="oa-price">'+o.p+'</span>'+
   '<span class="oa-chev">'+(open?'▲':'▼')+'</span>'+
  '</button>'+
  '<div class="offer-acc-body">'+
   '<p>'+o.d+'</p>'+
   '<p class="oa-dates">\U0001F4C5 '+offerDatesLabel(o.id)+'</p>'+
   '<button class="apply" onclick="applyOffer(\''+o.id+'\')">'+(proceed?'Proceed with this offer ➜':'Apply & pick date ➜')+'</button>'+
  '</div></div>';
}
function renderOffers(){
 const g=document.getElementById('offer-grid'); if(g) g.innerHTML=offers.map(offerAcc).join('');
 const pl=document.getElementById('plan-offers'); if(!pl) return;
 const list=(selDate? offers.filter(function(o){return dateOk(o.id,selDate);}) : offers);
 pl.innerHTML = list.length? list.map(offerAcc).join('')
   : '<p class="no-offer">😔 No offers available for '+selDate+'. Offers need a future date — pick another day or <a onclick="clearDate()">clear the date</a>.</p>';
 var hint=document.getElementById('offer-hint');
 if(hint) hint.textContent = selDate? ('Showing offers valid on '+selDate) : (selOffer? ('Calendar now shows dates for '+selOffer.n) : 'Tap an offer to see its valid dates');
}
function applyOffer(id){
 selOffer=offers.find(o=>o.id===id);
 go('book');
 renderOffers(); renderCal();
 if(!selDate){bookStep(1);toast('📅 Now pick a highlighted date for this offer');return;}
 if(!dateOk(id,selDate)){selDate='';renderOffers();renderCal();bookStep(1);toast('📅 Pick a date valid for this offer');return;}
 bookStep(2);toast('🎁 "'+selOffer.n+'" applied — choose your tickets');
}
function toggleOffer(id){
 if(selOffer&&selOffer.id===id){selOffer=null;}
 else{selOffer=offers.find(o=>o.id===id); if(selDate&&!dateOk(id,selDate)) selDate='';}
 renderOffers(); renderCal();
}
function clearDate(){selDate='';renderOffers();renderCal();}
function clearOffer(){selOffer=null;renderOffers();renderCal();}

/* ---------------- calendar (date right panel) ---------------- */
const MN=['January','February','March','April','May','June','July','August','September','October','November','December'];
function pad(n){return (n<10?'0':'')+n}
function iso(y,m,d){return y+'-'+pad(m+1)+'-'+pad(d)}
function todayISO(){const t=new Date();return iso(t.getFullYear(),t.getMonth(),t.getDate())}
function renderCal(){
 const c=document.getElementById('cal'); if(!c) return;
 const t=new Date(); if(calY===undefined){calY=t.getFullYear();calM=t.getMonth();}
 const first=new Date(calY,calM,1).getDay(), days=new Date(calY,calM+1,0).getDate();
 const atCur=(calY===t.getFullYear()&&calM===t.getMonth());
 let h=`<div class="cal-head"><button class="cal-nav" ${atCur?'disabled':''} onclick="calShift(-1)">‹</button><b>${MN[calM]} ${calY}</b><button class="cal-nav" onclick="calShift(1)">›</button></div>`;
 if(selOffer) h+=`<p class="cal-filter">📅 Dates for <b>${selOffer.n}</b> · <a onclick="clearOffer()">show all</a></p>`;
 h+='<div class="cal-grid">'+['SUN','MON','TUE','WED','THU','FRI','SAT'].map(d=>`<span class="dow">${d}</span>`).join('');
 for(let i=0;i<first;i++)h+='<span></span>';
 for(let d=1;d<=days;d++){
  const dt=iso(calY,calM,d);
  const past=dt<todayISO();
  const okOffer=selOffer? dateOk(selOffer.id,dt):true;
  const disabled=past||!okOffer;
  const cls='day'+(dt===selDate?' sel':'')+(selOffer&&okOffer?' okday':'');
  h+=`<button class="${cls}" ${disabled?'disabled':''} onclick="pickDate('${dt}')">${d}</button>`;
 }
 c.innerHTML=h+'</div>';
}
function calShift(v){calM+=v; if(calM<0){calM=11;calY--} if(calM>11){calM=0;calY++} renderCal();}
function pickDate(dt){selDate=dt;renderCal();renderOffers();}
function proceedDate(){ if(!selDate){toast('📅 Please pick your visit date first');return;} bookStep(2); }

/* ---------------- booking ---------------- */
function chg(k,v){qty[k]=Math.max(0,qty[k]+v);document.getElementById('q-'+k).textContent=qty[k];updateLiveTotal();}
function gotoStep(n){ if(n>=2 && !selDate){toast('📅 Please pick your visit date first');return;} bookStep(n); }
function updateLiveTotal(){
 var tix=ticketSubtotal();
 var food=qty.veg*prices.veg+qty.nonveg*prices.nonveg;
 var n=['adult','child','senior','student','dfpa','dfpc'].reduce(function(s,k){return s+qty[k];},0);
 var txt=(selOffer?('🎁 '+selOffer.n+' · '):'')+'🧮 '+n+' ticket'+(n===1?'':'s')+(food?' + food':'')+' · Subtotal '+fmt(tix+food)+' (before tax)';
 document.querySelectorAll('.live-total').forEach(function(el){el.textContent=txt;});
}
function bookStep(n){
 for(let i=1;i<=4;i++){
  document.getElementById('bstep'+i).style.display=(i===n)?'':'none';
  const s=document.getElementById('st'+i);
  s.className='step'+(i<n?' done':i===n?' now':'');
 }
 if(n===1){renderCal();renderOffers();}
 if(n===4) renderCheckout();
 updateLiveTotal();
 document.getElementById('page-book').scrollIntoView({behavior:'smooth'});
}
function renderBooking(){bookStep(selOffer&&selDate?4:1);}
function ticketSubtotal(){return ['adult','child','senior','student','dfpa','dfpc'].reduce((s,k)=>s+qty[k]*prices[k],0);}
function buy2get1(){
 var keys=['adult','child','senior','student','dfpa','dfpc'], arr=[];
 keys.forEach(function(k){for(var i=0;i<qty[k];i++)arr.push(prices[k]);});
 if(arr.length<3) return null;
 arr.sort(function(a,b){return a-b;});
 var free=Math.floor(arr.length/3), amt=0, i;
 for(i=0;i<free;i++)amt+=arr[i];
 return {free:free,amt:amt};
}
function offerDiscount(){
 if(!selOffer) return {amt:0,note:''};
 /* Offers are never valid for same-day (or past) visit dates */
 if(selDate && selDate<=todayISO()) return {amt:0,note:'⚠️ Offers close at 12 AM — no offer is available for same-day bookings. Please pick a future date.'};
 if(selOffer.id==='kids'){
  if(!selDate) return {amt:0,note:'📅 Pick a Saturday visit date — kids below 130 cm go FREE on Saturdays.'};
  if(new Date(selDate+'T12:00:00').getDay()!==6) return {amt:0,note:'⚠️ Little Legends is valid on Saturdays only — please pick a Saturday.'};
  if(!qty.adult) return {amt:0,note:'ℹ️ Add at least 1 Adult Fun Pass — each adult unlocks 2 free kids.'};
  if(!qty.child) return {amt:0,note:'ℹ️ Add Child Fun Passes — each adult unlocks 2 free kids below 130 cm.'};
  const freeKids=Math.min(qty.child, 2*qty.adult);
  const note=freeKids<qty.child?('✔️ '+freeKids+' kid(s) FREE with '+qty.adult+' adult(s) — remaining '+(qty.child-freeKids)+' child pass(es) charged.'):('✔️ '+freeKids+' kid(s) FREE!');
  return {amt:freeKids*prices.child,note:note};
 }
 if(selOffer.id==='independence'){
  if(!selDate) return {amt:0,note:'📅 Pick 15 August as your visit date to unlock this offer.'};
  if(selDate.slice(5)!=='08-15') return {amt:0,note:'⚠️ Independence Day Special is valid only on 15 August.'};
  if(!qty.adult) return {amt:0,note:'ℹ️ Add an Adult Fun Pass — special price ₹800 (before tax) each on 15 August.'};
  const perAdultSaving=Math.max(0,prices.adult-800);
  return {amt:qty.adult*perAdultSaving,note:'🇮🇳 Adult Fun Pass at ₹800 (before tax) each this Independence Day.'};
 }
 if(selOffer.id==='birthday'){
  if(qty.adult<2) return {amt:0,note:'🎂 Add 2 or more Adult Fun Passes — buy 1, get 1 free.'};
  const freeAdults=Math.floor(qty.adult/2);
  return {amt:freeAdults*prices.adult,note:'🎂 '+freeAdults+' Adult Fun Pass(es) FREE — carry valid birthday ID proof at entry.'};
 }
 if(selOffer.id==='midweek'){
  if(!selDate) return {amt:0,note:'📅 Pick any Tuesday or Wednesday to unlock buy 2, get 1 free.'};
  var dow=new Date(selDate+'T12:00:00').getDay();
  if(dow!==2&&dow!==3) return {amt:0,note:'⚠️ Valid on Tuesdays & Wednesdays only — please pick a Tue or Wed.'};
  var rm=buy2get1(); if(!rm) return {amt:0,note:'ℹ️ Add at least 3 passes — buy 2, get 1 free.'};
  return {amt:rm.amt,note:'✔️ '+rm.free+' ticket(s) FREE — buy 2, get 1 free on all pass categories.'};
 }
 if(selOffer.id==='friendship'){
  if(!selDate) return {amt:0,note:'📅 Pick 2 August to unlock the Friendship Day treat.'};
  if(selDate.slice(5)!=='08-02') return {amt:0,note:'⚠️ Friendship Trio Treat is valid only on 2 August.'};
  var rf=buy2get1(); if(!rf) return {amt:0,note:'ℹ️ Add at least 3 passes — two book, the third goes free.'};
  return {amt:rf.amt,note:'✔️ '+rf.free+' ticket(s) FREE — two book, the third bestie goes free!'};
 }
 if(selOffer.id==='dfpadult'){
  if(!qty.dfpa) return {amt:0,note:'ℹ️ Add a Double Fun Pass — Adult to enjoy ₹1,313 (save ₹402 vs ₹1,715).'};
  return {amt:0,note:'✅ Double Fun Pass — Adult already at the special ₹1,313 (save ₹402). Tax applies at checkout.'};
 }
 if(selOffer.id==='dfpchild'){
  if(!qty.dfpc) return {amt:0,note:'ℹ️ Add a Double Fun Pass — Child to enjoy ₹1,128 (save ₹275 vs ₹1,403).'};
  return {amt:0,note:'✅ Double Fun Pass — Child already at the special ₹1,128 (save ₹275). Tax applies at checkout.'};
 }
 if(selOffer.id==='student'){
  if(!qty.student) return {amt:0,note:'ℹ️ Add a College Student ID Fun Pass to use this offer.'};
  return {amt:.20*qty.student*prices.student,note:'🪪 Carry your college ID card — offer valid only on ID display at entry.'};
 }
 return {amt:0,note:''};
}
function renderCheckout(){
 document.getElementById('c-date').value=selDate||'Not selected';
 const ao=document.getElementById('applied-offer');
 const disc=offerDiscount();
 if(selOffer){ao.style.display='block';ao.textContent='🎁 Offer applied: '+selOffer.n+' ('+selOffer.s+')'+(disc.amt?' — saving '+fmt(disc.amt):'')+(disc.note?' · '+disc.note:'');}
 else ao.style.display='none';
 const FOOD=['veg','nonveg'];
 let rows='',tix=0,food=0;
 for(const k in qty){if(qty[k]>0){const amt=qty[k]*prices[k];
  if(FOOD.includes(k)) food+=amt; else tix+=amt;
  rows+=`<div class="row"><span>${labels[k]} × ${qty[k]}</span><span>${fmt(amt)}</span></div>`;}}
 if(disc.amt){rows+=`<div class="row" style="color:var(--green-deep)"><span>Offer: ${selOffer.n}</span><span>− ${fmt(disc.amt)}</span></div>`;}
 const tixNet=Math.max(0,tix-disc.amt);
 const gstT=.18*tixNet, gstF=.05*food;
 if(tixNet) rows+=`<div class="row"><span>GST on tickets (18%)</span><span>+ ${fmt(gstT)}</span></div>`;
 if(food)   rows+=`<div class="row"><span>GST on food (5%)</span><span>+ ${fmt(gstF)}</span></div>`;
 rows+=`<div class="row total"><span>Total</span><span>${fmt(tixNet+gstT+food+gstF)}</span></div>`;
 document.getElementById('summary').innerHTML=rows;
}
function esc(s){return String(s).replace(/[<>&"]/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];});}
function validEmail(x){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(x);}
function validPhone(x){return /^[+]?\d[\d\s-]{7,14}$/.test(x);}
function pay(){
 var n=document.getElementById('c-name').value.trim();
 var e=document.getElementById('c-email').value.trim();
 var p=document.getElementById('c-phone').value.trim();
 if(!selDate){toast('\U0001F4C5 Please pick a visit date');bookStep(1);return;}
 var tixCount=['adult','child','senior','student','dfpa','dfpc'].reduce(function(s,k){return s+qty[k];},0);
 if(tixCount<1){toast('\U0001F3AB Add at least one ticket');bookStep(2);return;}
 if(!n){toast('⚠️ Please enter your name');document.getElementById('c-name').focus();return;}
 if(!validEmail(e)){toast('\U0001F4E7 Enter a valid email address');document.getElementById('c-email').focus();return;}
 if(!validPhone(p)){toast('\U0001F4F1 Enter a valid contact number');document.getElementById('c-phone').focus();return;}
 var disc=offerDiscount();
 var tixNet=Math.max(0,ticketSubtotal()-disc.amt);
 var food=qty.veg*prices.veg+qty.nonveg*prices.nonveg;
 var grand=tixNet+.18*tixNet+food+.05*food;
 var ref='UKD-'+(Date.now().toString(36)+Math.random().toString(36).slice(2,5)).toUpperCase().slice(-8);
 var booking={ref:ref,name:n,email:e,phone:p,date:selDate,total:grand,items:Object.assign({},qty),offer:selOffer?selOffer.n:null,ts:new Date().toISOString()};
 try{var all=JSON.parse(localStorage.getItem('ukdBookings')||'[]');all.push(booking);localStorage.setItem('ukdBookings',JSON.stringify(all));}catch(_){}
 document.getElementById('bstep4').innerHTML=
  '<div class="conf-card"><div class="conf-check">✅</div>'+
  '<h3>Booking Confirmed!</h3>'+
  '<p>Thank you, '+esc(n)+'. Your e-tickets for <b>'+esc(selDate)+'</b> have been sent to <b>'+esc(e)+'</b>.</p>'+
  '<div class="conf-ref">Booking reference<br><b>'+ref+'</b></div>'+
  '<div class="conf-total">Amount paid: <b>'+fmt(grand)+'</b></div>'+
  '<button class="btn-next" onclick="location.reload()">Make another booking</button></div>';
 document.getElementById('bstep4').scrollIntoView({behavior:'smooth',block:'center'});
 toast('\U0001F389 Booking confirmed — ref '+ref);
}
function sendContact(){
 var n=document.getElementById('ct-name').value.trim();
 var e=document.getElementById('ct-email').value.trim();
 var m=document.getElementById('ct-msg').value.trim();
 if(!n){toast('⚠️ Please enter your name');document.getElementById('ct-name').focus();return;}
 if(!validEmail(e)){toast('\U0001F4E7 Enter a valid email');document.getElementById('ct-email').focus();return;}
 if(!m){toast('✍️ Please enter a message');document.getElementById('ct-msg').focus();return;}
 try{var all=JSON.parse(localStorage.getItem('ukdMessages')||'[]');all.push({n:n,e:e,m:m,ts:new Date().toISOString()});localStorage.setItem('ukdMessages',JSON.stringify(all));}catch(_){}
 document.getElementById('ct-name').value='';document.getElementById('ct-email').value='';document.getElementById('ct-msg').value='';
 toast('\U0001F4E8 Thanks '+n+'! Your message was sent.');
}
function doLogin(){
 var u=document.getElementById('login-user').value.trim();
 var pw=document.getElementById('login-pass').value;
 var isOp=document.getElementById('tab-operator').classList.contains('active');
 if(!u){toast('⚠️ Enter your email or mobile');return;}
 if(pw.length<4){toast('\U0001F512 Password must be at least 4 characters');return;}
 if(isOp){var code=document.getElementById('login-op').value.trim();if(!/^UKD-OP-\d{4}$/i.test(code)){toast('\U0001F9F3 Enter a valid operator code (e.g. UKD-OP-1234)');return;}}
 try{localStorage.setItem('ukdUser',JSON.stringify({user:u,operator:isOp,ts:Date.now()}));}catch(_){}
 closeModal('login-modal');
 toast('\U0001F511 Welcome, '+u+'!');
 reflectLogin();
}
function reflectLogin(){
 var u=null;try{u=JSON.parse(localStorage.getItem('ukdUser')||'null');}catch(_){}
 document.querySelectorAll('.btn-login').forEach(function(b){
  if(u){b.textContent='\U0001F464 '+u.user.split('@')[0].slice(0,12);b.onclick=logout;}
  else{b.textContent='Login';b.onclick=function(){openLogin('guest');};}
 });
}
function logout(){try{localStorage.removeItem('ukdUser');}catch(_){}reflectLogin();toast('\U0001F44B Logged out');}
document.addEventListener('DOMContentLoaded',reflectLogin);
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.scroll-banner').forEach(function(b,i){b.classList.add('sb-c'+(i%5));});});
document.addEventListener('DOMContentLoaded',function(){var p=['orn-swirl','orn-zig','orn-cross'],i=0;document.querySelectorAll('.section-head').forEach(function(sh){var d=document.createElement('div');d.className='ornament '+p[i%3];i++;sh.parentNode.insertBefore(d,sh.nextSibling);});});
renderOffers();renderCal();

/* ---------------- popups ---------------- */
function ticketPopup(t){
 document.getElementById('tp-title').textContent='🎟️ '+t+' Pass';
 document.getElementById('tp-body').innerHTML={
  Adult:'Theme Park & Beach Access.<br>✅ All regular rides & water park.<br>💰 <s>₹975</s> → <b>₹828.75</b> online price.',
  Child:'For kids 90–130 cm tall.<br>✅ Theme Park & Beach Access.<br>🎁 FREE below 90 cm — and free below 130 cm with the Little Legends offer!<br>💰 <s>₹763</s> → <b>₹648.55</b>.',
  Senior:'Age 60+ with valid ID.<br>✅ Theme Park & Beach Access.<br>💰 <s>₹763</s> → <b>₹648.55</b>.',
  Student:'Current-year college ID mandatory at entry.<br>✅ Theme Park & Beach Access.<br>💰 ₹780 — or 20% off with the Student Pass offer!',
  Double:'One ticket, two kingdoms!<br>✅ VGP Universal Kingdom + VGP Marine Kingdom.<br>💰 Adult <s>₹1,715</s> ₹1,313 · Child <s>₹1,403</s> ₹1,128 (before tax).'}[t];
 document.getElementById('ticket-modal').classList.add('show');
}
function openLogin(t){document.getElementById('login-modal').classList.add('show');loginTab(t);}
function loginTab(t){
 document.getElementById('tab-guest').classList.toggle('active',t==='guest');
 document.getElementById('tab-operator').classList.toggle('active',t==='operator');
 document.getElementById('op-code').style.display=t==='operator'?'':'none';
 document.getElementById('login-title').textContent=t==='operator'?"🧳 Tour Operator's Login":'🔑 Login';
}
function closeModal(id){document.getElementById(id).classList.remove('show');}
/* ---------------- intro video ---------------- */
const YT_ID='a1Fw7SqAcP0';
const INTRO_SRC='https://www.youtube.com/embed/'+YT_ID+'?autoplay=1&mute=1&playsinline=1&rel=0&loop=1&playlist='+YT_ID;
function introIframe(){document.getElementById('intro-media').innerHTML=
 `<iframe src="${INTRO_SRC}" title="VGP Universal Kingdom — official video" frameborder="0" allow="autoplay; encrypted-media; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>`;}
function introSplash(){document.getElementById('intro-media').innerHTML=
 `<div class="intro-splash" style="background-image:url('https://img.youtube.com/vi/${YT_ID}/maxresdefault.jpg')">
   <a class="intro-play" href="https://www.youtube.com/watch?v=${YT_ID}" target="_blank" rel="noopener"><span class="play-btn"></span>▶ Watch the official video</a>
   <p class="intro-hint">In-page playback starts automatically once the site is hosted online.<br>Tip: save the video as <b>intro.mp4</b> next to this file to play it right here.</p>
  </div>`;}
function openIntro(){
 document.getElementById('intro').classList.add('show');
 const m=document.getElementById('intro-media');
 m.innerHTML='<video src="intro.mp4" autoplay muted loop playsinline></video>';
 const v=m.querySelector('video');
 v.onerror=()=>{ if(location.protocol==='file:') introSplash(); else introIframe(); };
 if(v.error) v.onerror();
}
function closeIntro(){document.getElementById('intro').classList.remove('show');document.getElementById('intro-media').innerHTML='';}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeIntro();});
(function heroMedia(){
 const hv=document.getElementById('hero-video'); if(!hv) return;
 const v=document.createElement('video');
 v.src='intro.mp4'; v.autoplay=true; v.muted=true; v.loop=true; v.playsInline=true;
 v.onerror=()=>{ if(v.parentNode) hv.removeChild(v); };  /* no YouTube fallback — keep clean decorative hero */
 hv.appendChild(v);
})();
let toastT;
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2600);}
</script>
</body>
</html>
